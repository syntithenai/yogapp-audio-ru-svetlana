{
  "id": "gratitude-5",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 172,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Найдите удобное сиденье или лягте, если вам так удобнее.",
      "file": "c001.ogg",
      "durationSec": 8.256
    },
    {
      "index": 2,
      "text": "Дайте рукам отдохнуть.",
      "file": "c002.ogg",
      "durationSec": 4.464
    },
    {
      "index": 3,
      "text": "Смягчите глаза или закройте их.",
      "file": "c003.ogg",
      "durationSec": 5.664
    },
    {
      "index": 4,
      "text": "Сделайте медленный вдох.",
      "file": "c004.ogg",
      "durationSec": 4.584
    },
    {
      "index": 5,
      "text": "И более длинный выдох.",
      "file": "c005.ogg",
      "durationSec": 4.32
    },
    {
      "index": 6,
      "text": "Вспомните одну маленькую вещь, которая помогла вам сегодня или на этой неделе.",
      "file": "c006.ogg",
      "durationSec": 9.888
    },
    {
      "index": 7,
      "text": "Это может быть обычный. Теплая вода. Сообщение. Свет на стене.",
      "file": "c007.ogg",
      "durationSec": 14.952
    },
    {
      "index": 8,
      "text": "[пауза:21]",
      "file": "c008.ogg",
      "durationSec": 4.392
    },
    {
      "index": 9,
      "text": "Аккуратно удерживайте его в осознании.",
      "file": "c009.ogg",
      "durationSec": 5.664
    },
    {
      "index": 10,
      "text": "Обратите внимание на любое смягчение груди или лица.",
      "file": "c010.ogg",
      "durationSec": 7.392
    },
    {
      "index": 11,
      "text": "[пауза:26]",
      "file": "c011.ogg",
      "durationSec": 4.536
    },
    {
      "index": 12,
      "text": "Молча поблагодарите одну вещь.",
      "file": "c012.ogg",
      "durationSec": 5.352
    },
    {
      "index": 13,
      "text": "Спасибо, что вы здесь.",
      "file": "c013.ogg",
      "durationSec": 4.608
    },
    {
      "index": 14,
      "text": "[пауза:21]",
      "file": "c014.ogg",
      "durationSec": 4.392
    },
    {
      "index": 15,
      "text": "Теперь второе. Еще одно маленькое добро.",
      "file": "c015.ogg",
      "durationSec": 8.64
    },
    {
      "index": 16,
      "text": "[пауза:26]",
      "file": "c016.ogg",
      "durationSec": 4.536
    },
    {
      "index": 17,
      "text": "Спасибо.",
      "file": "c017.ogg",
      "durationSec": 3.264
    },
    {
      "index": 18,
      "text": "[пауза: 15]",
      "file": "c018.ogg",
      "durationSec": 4.512
    },
    {
      "index": 19,
      "text": "И еще один. Третий.",
      "file": "c019.ogg",
      "durationSec": 6.36
    },
    {
      "index": 20,
      "text": "[пауза:26]",
      "file": "c020.ogg",
      "durationSec": 4.536
    },
    {
      "index": 21,
      "text": "Пусть благодарность будет простой. Не принудительный. Только что заметил.",
      "file": "c021.ogg",
      "durationSec": 12.816
    },
    {
      "index": 22,
      "text": "[пауза:31]",
      "file": "c022.ogg",
      "durationSec": 4.584
    },
    {
      "index": 23,
      "text": "Отдохните в этом тепле несколько вдохов.",
      "file": "c023.ogg",
      "durationSec": 5.928
    },
    {
      "index": 24,
      "text": "[пауза: 41]",
      "file": "c024.ogg",
      "durationSec": 4.224
    },
    {
      "index": 25,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c025.ogg",
      "durationSec": 5.328
    },
    {
      "index": 26,
      "text": "Пошевелите пальцами.",
      "file": "c026.ogg",
      "durationSec": 4.344
    },
    {
      "index": 27,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c027.ogg",
      "durationSec": 5.76
    },
    {
      "index": 28,
      "text": "Носите немного этого с собой.",
      "file": "c028.ogg",
      "durationSec": 5.16
    }
  ]
}

{
  "id": "forest-path-10",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 732,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Найдите позу, которая ничего от вас не требует.",
      "file": "c001.ogg",
      "durationSec": 6.792
    },
    {
      "index": 2,
      "text": "Сядьте или лягте с любой поддержкой, которая вам нужна.",
      "file": "c002.ogg",
      "durationSec": 7.632
    },
    {
      "index": 3,
      "text": "Пусть ваши руки будут открытыми или мягкими.",
      "file": "c003.ogg",
      "durationSec": 6.528
    },
    {
      "index": 4,
      "text": "Позвольте глазам закрыться или сохраняйте мягкий взгляд.",
      "file": "c004.ogg",
      "durationSec": 7.368
    },
    {
      "index": 5,
      "text": "Почувствуйте места, где ваше тело встречается с землей.",
      "file": "c005.ogg",
      "durationSec": 7.344
    },
    {
      "index": 6,
      "text": "Пятки, седалищные кости, затылок или длина позвоночника.",
      "file": "c006.ogg",
      "durationSec": 8.496
    },
    {
      "index": 7,
      "text": "Нечего сейчас задерживать.",
      "file": "c007.ogg",
      "durationSec": 5.04
    },
    {
      "index": 8,
      "text": "Сделайте медленный вдох через нос.",
      "file": "c008.ogg",
      "durationSec": 5.4
    },
    {
      "index": 9,
      "text": "Почувствуйте прохладу приходящего воздуха.",
      "file": "c009.ogg",
      "durationSec": 6.024
    },
    {
      "index": 10,
      "text": "И выдохните еще немного.",
      "file": "c010.ogg",
      "durationSec": 4.656
    },
    {
      "index": 11,
      "text": "Почувствуйте, как уходит тепло выдоха.",
      "file": "c011.ogg",
      "durationSec": 5.928
    },
    {
      "index": 12,
      "text": "Снова. Мягкий вдох.",
      "file": "c012.ogg",
      "durationSec": 6.264
    },
    {
      "index": 13,
      "text": "Неторопливый выдох.",
      "file": "c013.ogg",
      "durationSec": 3.912
    },
    {
      "index": 14,
      "text": "Позвольте плечам немного опуститься.",
      "file": "c014.ogg",
      "durationSec": 5.784
    },
    {
      "index": 15,
      "text": "Позвольте челюсти разжаться.",
      "file": "c015.ogg",
      "durationSec": 4.944
    },
    {
      "index": 16,
      "text": "Пусть живот будет мягким.",
      "file": "c016.ogg",
      "durationSec": 4.728
    },
    {
      "index": 17,
      "text": "Оставайтесь с тремя спокойными вдохами, как есть.",
      "file": "c017.ogg",
      "durationSec": 7.032
    },
    {
      "index": 18,
      "text": "Вдохните. Приезжать.",
      "file": "c018.ogg",
      "durationSec": 6.552
    },
    {
      "index": 19,
      "text": "Выдохните. Решить.",
      "file": "c019.ogg",
      "durationSec": 6.264
    },
    {
      "index": 20,
      "text": "Если ум блуждает, милостиво обратите на это внимание и вернитесь к этому дыханию.",
      "file": "c020.ogg",
      "durationSec": 10.224
    },
    {
      "index": 21,
      "text": "Теперь начните медленную прогулку в старый лес.",
      "file": "c021.ogg",
      "durationSec": 6.36
    },
    {
      "index": 22,
      "text": "Тропа мягкая, усыпанная хвоей и опавшими листьями.",
      "file": "c022.ogg",
      "durationSec": 7.8
    },
    {
      "index": 23,
      "text": "Каждый шаг издает тихий звук, затем возвращается тишина.",
      "file": "c023.ogg",
      "durationSec": 8.232
    },
    {
      "index": 24,
      "text": "Солнечный свет теплыми лентами пронизывает высокие ветки.",
      "file": "c024.ogg",
      "durationSec": 7.656
    },
    {
      "index": 25,
      "text": "Почувствуйте луч солнца на предплечье — внезапное нежное тепло.",
      "file": "c025.ogg",
      "durationSec": 8.016
    },
    {
      "index": 26,
      "text": "Затем снова заштрихуйте, прохладно-зеленым.",
      "file": "c026.ogg",
      "durationSec": 6.672
    },
    {
      "index": 27,
      "text": "Ветер колышет купол. Свежий воздух находит ваше лицо.",
      "file": "c027.ogg",
      "durationSec": 9.72
    },
    {
      "index": 28,
      "text": "Запах смолы, влажной почвы и чистой сладости мха.",
      "file": "c028.ogg",
      "durationSec": 7.584
    },
    {
      "index": 29,
      "text": "Пауза. Положите ладонь на грубую кору.",
      "file": "c029.ogg",
      "durationSec": 7.92
    },
    {
      "index": 30,
      "text": "Почувствуйте, как тишина дерева входит в вашу руку.",
      "file": "c030.ogg",
      "durationSec": 7.392
    },
    {
      "index": 31,
      "text": "Продолжайте глубже. Звуки внешнего мира затихают.",
      "file": "c031.ogg",
      "durationSec": 9.216
    },
    {
      "index": 32,
      "text": "Где-то маленькими яркими слогами говорит ручей.",
      "file": "c032.ogg",
      "durationSec": 6.888
    },
    {
      "index": 33,
      "text": "Следуйте до тех пор, пока между камнями не появится вода.",
      "file": "c033.ogg",
      "durationSec": 7.584
    },
    {
      "index": 34,
      "text": "Встаньте на колени. Опустите руки. Классная ясность.",
      "file": "c034.ogg",
      "durationSec": 11.736
    },
    {
      "index": 35,
      "text": "Расплескайте немного на запястьях. Свежесть пробуждает кожу.",
      "file": "c035.ogg",
      "durationSec": 10.032
    },
    {
      "index": 36,
      "text": "Сядьте на плоский камень, согретый узким столбиком солнца.",
      "file": "c036.ogg",
      "durationSec": 8.208
    },
    {
      "index": 37,
      "text": "Почувствуйте это тепло в седалищных костях и задней части бедер.",
      "file": "c037.ogg",
      "durationSec": 8.112
    },
    {
      "index": 38,
      "text": "Почувствуйте прохладное дыхание ручья на своих голенях.",
      "file": "c038.ogg",
      "durationSec": 7.176
    },
    {
      "index": 39,
      "text": "Птицы кричат ​​один раз, а затем снова покидают тишину.",
      "file": "c039.ogg",
      "durationSec": 7.92
    },
    {
      "index": 40,
      "text": "Вдохните свежесть леса.",
      "file": "c040.ogg",
      "durationSec": 4.848
    },
    {
      "index": 41,
      "text": "Выдохните в тело пациента вокруг вас.",
      "file": "c041.ogg",
      "durationSec": 5.544
    },
    {
      "index": 42,
      "text": "Обратите внимание, как ваши плечи опустились, хотя вас об этом не просили.",
      "file": "c042.ogg",
      "durationSec": 9.528
    },
    {
      "index": 43,
      "text": "Как смягчается челюсть, когда больше некуда идти.",
      "file": "c043.ogg",
      "durationSec": 7.32
    },
    {
      "index": 44,
      "text": "Встаньте, когда будете готовы, и пройдите немного дальше.",
      "file": "c044.ogg",
      "durationSec": 8.112
    },
    {
      "index": 45,
      "text": "Папоротники ласкают ваши икры прохладными зелеными кончиками пальцев.",
      "file": "c045.ogg",
      "durationSec": 8.664
    },
    {
      "index": 46,
      "text": "Открывается поляна — круглая, как затаенное дыхание.",
      "file": "c046.ogg",
      "durationSec": 8.016
    },
    {
      "index": 47,
      "text": "Лягте на глубокий мох.",
      "file": "c047.ogg",
      "durationSec": 4.296
    },
    {
      "index": 48,
      "text": "Земля полностью принимает на себя ваш вес.",
      "file": "c048.ogg",
      "durationSec": 6.096
    },
    {
      "index": 49,
      "text": "Тепло фильтрованного солнца на вашем лице.",
      "file": "c049.ogg",
      "durationSec": 5.904
    },
    {
      "index": 50,
      "text": "Прохлада мха вдоль позвоночника.",
      "file": "c050.ogg",
      "durationSec": 5.544
    },
    {
      "index": 51,
      "text": "Ветерок приходит, уходит, приходит снова.",
      "file": "c051.ogg",
      "durationSec": 7.032
    },
    {
      "index": 52,
      "text": "Оставайтесь с ощущением того, что вас держит живое место.",
      "file": "c052.ogg",
      "durationSec": 7.824
    },
    {
      "index": 53,
      "text": "Безопасный. Тихий. Принадлежность без усилий.",
      "file": "c053.ogg",
      "durationSec": 11.256
    },
    {
      "index": 54,
      "text": "Насчитайте здесь пять медленных вдохов, каждое более мягкое.",
      "file": "c054.ogg",
      "durationSec": 8.472
    },
    {
      "index": 55,
      "text": "Еще раз обратите внимание на аромат — зеленый, влажный, честный.",
      "file": "c055.ogg",
      "durationSec": 9.264
    },
    {
      "index": 56,
      "text": "Еще раз обратите внимание на звук — его почти нет, и этого достаточно.",
      "file": "c056.ogg",
      "durationSec": 9.456
    },
    {
      "index": 57,
      "text": "Если появляется мысль, позвольте ей плыть, как лист по течению.",
      "file": "c057.ogg",
      "durationSec": 8.904
    },
    {
      "index": 58,
      "text": "Вернитесь к теплу на кожу, где бы вас ни нашло солнце.",
      "file": "c058.ogg",
      "durationSec": 7.272
    },
    {
      "index": 59,
      "text": "Вернитесь в прохладу в тени между теплыми лентами.",
      "file": "c059.ogg",
      "durationSec": 6.96
    },
    {
      "index": 60,
      "text": "Вы зашли достаточно далеко внутрь себя.",
      "file": "c060.ogg",
      "durationSec": 5.856
    },
    {
      "index": 61,
      "text": "Позвольте трем медленным вдохам закрепить это в теле.",
      "file": "c061.ogg",
      "durationSec": 7.176
    },
    {
      "index": 62,
      "text": "Прежде чем уйти, встаньте еще раз у ручья.",
      "file": "c062.ogg",
      "durationSec": 6.216
    },
    {
      "index": 63,
      "text": "Наблюдайте, как прозрачная вода оплетает камни.",
      "file": "c063.ogg",
      "durationSec": 7.368
    },
    {
      "index": 64,
      "text": "Холодный воздух поднимается от движущейся поверхности.",
      "file": "c064.ogg",
      "durationSec": 7.512
    },
    {
      "index": 65,
      "text": "Теплый свет все еще находит полоску вашего предплечья.",
      "file": "c065.ogg",
      "durationSec": 7.488
    },
    {
      "index": 66,
      "text": "Если хотите, налейте воды и намочите бровь — в воображении прохладно и добро.",
      "file": "c066.ogg",
      "durationSec": 10.296
    },
    {
      "index": 67,
      "text": "Лес не аплодирует. Это просто продолжается.",
      "file": "c067.ogg",
      "durationSec": 8.832
    },
    {
      "index": 68,
      "text": "Это продолжение является учителем.",
      "file": "c068.ogg",
      "durationSec": 5.64
    },
    {
      "index": 69,
      "text": "Пройдите по пути наружу, сделав несколько тихих шагов в уме.",
      "file": "c069.ogg",
      "durationSec": 8.112
    },
    {
      "index": 70,
      "text": "Иголки под ногами. Мягкий звук. Мягкий возврат.",
      "file": "c070.ogg",
      "durationSec": 11.16
    },
    {
      "index": 71,
      "text": "Но мир поляны остается в сундуке, как хранимое солнце.",
      "file": "c071.ogg",
      "durationSec": 8.16
    },
    {
      "index": 72,
      "text": "Почувствуйте это там — тепло за грудиной.",
      "file": "c072.ogg",
      "durationSec": 5.904
    },
    {
      "index": 73,
      "text": "Почувствуйте свежесть в ноздрях.",
      "file": "c073.ogg",
      "durationSec": 5.232
    },
    {
      "index": 74,
      "text": "И то, и другое можно принести в обычные комнаты.",
      "file": "c074.ogg",
      "durationSec": 7.272
    },
    {
      "index": 75,
      "text": "Последний взгляд сквозь ветви на небесную монету.",
      "file": "c075.ogg",
      "durationSec": 6.648
    },
    {
      "index": 76,
      "text": "Достаточно.",
      "file": "c076.ogg",
      "durationSec": 3.552
    },
    {
      "index": 77,
      "text": "Теперь оставьте историю в покое и оставайтесь сенсацией.",
      "file": "c077.ogg",
      "durationSec": 7.8
    },
    {
      "index": 78,
      "text": "Вдохните свежесть этого места.",
      "file": "c078.ogg",
      "durationSec": 5.448
    },
    {
      "index": 79,
      "text": "Вдохните его тепло и тишину.",
      "file": "c079.ogg",
      "durationSec": 5.232
    },
    {
      "index": 80,
      "text": "Вдохните.",
      "file": "c080.ogg",
      "durationSec": 3.36
    },
    {
      "index": 81,
      "text": "Выдохните.",
      "file": "c081.ogg",
      "durationSec": 3.336
    },
    {
      "index": 82,
      "text": "Снова. Мягкий вдох.",
      "file": "c082.ogg",
      "durationSec": 6.264
    },
    {
      "index": 83,
      "text": "Более длинный выдох.",
      "file": "c083.ogg",
      "durationSec": 4.248
    },
    {
      "index": 84,
      "text": "Почувствуйте тело, удерживаемое землей этого воображаемого мира.",
      "file": "c084.ogg",
      "durationSec": 8.688
    },
    {
      "index": 85,
      "text": "Вдохните.",
      "file": "c085.ogg",
      "durationSec": 3.36
    },
    {
      "index": 86,
      "text": "Выдохните.",
      "file": "c086.ogg",
      "durationSec": 3.336
    },
    {
      "index": 87,
      "text": "Если мысли блуждают, вернитесь к теплу на коже.",
      "file": "c087.ogg",
      "durationSec": 6.696
    },
    {
      "index": 88,
      "text": "Или охладить воздух у носа.",
      "file": "c088.ogg",
      "durationSec": 5.016
    },
    {
      "index": 89,
      "text": "Вдохните.",
      "file": "c089.ogg",
      "durationSec": 3.36
    },
    {
      "index": 90,
      "text": "Выдохните.",
      "file": "c090.ogg",
      "durationSec": 3.336
    },
    {
      "index": 91,
      "text": "Вдохните.",
      "file": "c091.ogg",
      "durationSec": 3.36
    },
    {
      "index": 92,
      "text": "Выдохните.",
      "file": "c092.ogg",
      "durationSec": 3.336
    },
    {
      "index": 93,
      "text": "Оставаться. Смягчить. Продолжать.",
      "file": "c093.ogg",
      "durationSec": 9.648
    },
    {
      "index": 94,
      "text": "Вдохните.",
      "file": "c094.ogg",
      "durationSec": 3.36
    },
    {
      "index": 95,
      "text": "Выдохните.",
      "file": "c095.ogg",
      "durationSec": 3.336
    },
    {
      "index": 96,
      "text": "Еще один легкий цикл.",
      "file": "c096.ogg",
      "durationSec": 5.016
    },
    {
      "index": 97,
      "text": "Вдохните.",
      "file": "c097.ogg",
      "durationSec": 3.36
    },
    {
      "index": 98,
      "text": "Выдохните.",
      "file": "c098.ogg",
      "durationSec": 3.336
    },
    {
      "index": 99,
      "text": "Задержитесь в этом чувстве еще на несколько вдохов.",
      "file": "c099.ogg",
      "durationSec": 6.792
    },
    {
      "index": 100,
      "text": "Тепло. Мягкость. Достаточно.",
      "file": "c100.ogg",
      "durationSec": 9.36
    },
    {
      "index": 101,
      "text": "Вы можете вернуться в это место, когда вам это понадобится.",
      "file": "c101.ogg",
      "durationSec": 7.32
    },
    {
      "index": 102,
      "text": "Оно живет в вашем внимании, а не только в воображении.",
      "file": "c102.ogg",
      "durationSec": 7.608
    },
    {
      "index": 103,
      "text": "Начните углублять дыхание.",
      "file": "c103.ogg",
      "durationSec": 5.424
    },
    {
      "index": 104,
      "text": "Снова почувствуйте комнату вокруг себя.",
      "file": "c104.ogg",
      "durationSec": 5.88
    },
    {
      "index": 105,
      "text": "Пошевелите пальцами. Смягчите пальцы ног.",
      "file": "c105.ogg",
      "durationSec": 8.592
    },
    {
      "index": 106,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c106.ogg",
      "durationSec": 5.76
    },
    {
      "index": 107,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c107.ogg",
      "durationSec": 5.328
    },
    {
      "index": 108,
      "text": "Несите это спокойствие во все, что произойдет дальше.",
      "file": "c108.ogg",
      "durationSec": 7.464
    }
  ]
}

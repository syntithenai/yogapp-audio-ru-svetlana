{
  "id": "deep-rest-20",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 510,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать в практику глубокого отдыха.",
      "file": "c000.ogg",
      "durationSec": 6.864
    },
    {
      "index": 1,
      "text": "Если можете, лягте на спину.",
      "file": "c001.ogg",
      "durationSec": 5.232
    },
    {
      "index": 2,
      "text": "Поддерживайте голову и колени, если это поможет.",
      "file": "c002.ogg",
      "durationSec": 7.056
    },
    {
      "index": 3,
      "text": "Пусть руки лежат по бокам, ладони мягкие.",
      "file": "c003.ogg",
      "durationSec": 6.864
    },
    {
      "index": 4,
      "text": "Закройте глаза.",
      "file": "c004.ogg",
      "durationSec": 3.816
    },
    {
      "index": 5,
      "text": "Больше негде быть.",
      "file": "c005.ogg",
      "durationSec": 4.032
    },
    {
      "index": 6,
      "text": "[пауза:23]",
      "file": "c006.ogg",
      "durationSec": 4.2
    },
    {
      "index": 7,
      "text": "Почувствуйте точки соприкосновения с полом или кроватью.",
      "file": "c007.ogg",
      "durationSec": 7.32
    },
    {
      "index": 8,
      "text": "Каблуки. Бедра. Лопатки. Голова.",
      "file": "c008.ogg",
      "durationSec": 11.784
    },
    {
      "index": 9,
      "text": "Позвольте телу удержаться.",
      "file": "c009.ogg",
      "durationSec": 4.848
    },
    {
      "index": 10,
      "text": "[пауза:23]",
      "file": "c010.ogg",
      "durationSec": 4.2
    },
    {
      "index": 11,
      "text": "Обратите внимание на естественное дыхание.",
      "file": "c011.ogg",
      "durationSec": 6.432
    },
    {
      "index": 12,
      "text": "Нет необходимости менять его.",
      "file": "c012.ogg",
      "durationSec": 4.944
    },
    {
      "index": 13,
      "text": "Приходит вдох.",
      "file": "c013.ogg",
      "durationSec": 3.768
    },
    {
      "index": 14,
      "text": "Выдохните листья.",
      "file": "c014.ogg",
      "durationSec": 4.416
    },
    {
      "index": 15,
      "text": "[пауза: 25]",
      "file": "c015.ogg",
      "durationSec": 4.416
    },
    {
      "index": 16,
      "text": "Если ум занят, это разрешено.",
      "file": "c016.ogg",
      "durationSec": 5.184
    },
    {
      "index": 17,
      "text": "В любом случае, ты можешь отдохнуть.",
      "file": "c017.ogg",
      "durationSec": 5.856
    },
    {
      "index": 18,
      "text": "Просто продолжайте возвращаться к ощущениям.",
      "file": "c018.ogg",
      "durationSec": 6.144
    },
    {
      "index": 19,
      "text": "[пауза:23]",
      "file": "c019.ogg",
      "durationSec": 4.2
    },
    {
      "index": 20,
      "text": "Перенесите осознание на правую ногу.",
      "file": "c020.ogg",
      "durationSec": 5.664
    },
    {
      "index": 21,
      "text": "Пальцы ног. Подошва. Пятка.",
      "file": "c021.ogg",
      "durationSec": 8.976
    },
    {
      "index": 22,
      "text": "[пауза:21]",
      "file": "c022.ogg",
      "durationSec": 4.392
    },
    {
      "index": 23,
      "text": "Правая голень.",
      "file": "c023.ogg",
      "durationSec": 3.552
    },
    {
      "index": 24,
      "text": "Колено.",
      "file": "c024.ogg",
      "durationSec": 2.904
    },
    {
      "index": 25,
      "text": "Бедро.",
      "file": "c025.ogg",
      "durationSec": 2.88
    },
    {
      "index": 26,
      "text": "[пауза:21]",
      "file": "c026.ogg",
      "durationSec": 4.392
    },
    {
      "index": 27,
      "text": "Правое бедро.",
      "file": "c027.ogg",
      "durationSec": 3.456
    },
    {
      "index": 28,
      "text": "Вся правая нога, тяжелая и тихая.",
      "file": "c028.ogg",
      "durationSec": 6.648
    },
    {
      "index": 29,
      "text": "[пауза:23]",
      "file": "c029.ogg",
      "durationSec": 4.2
    },
    {
      "index": 30,
      "text": "Левая нога.",
      "file": "c030.ogg",
      "durationSec": 3.576
    },
    {
      "index": 31,
      "text": "Пальцы ног. Подошва. Пятка.",
      "file": "c031.ogg",
      "durationSec": 8.976
    },
    {
      "index": 32,
      "text": "[пауза:21]",
      "file": "c032.ogg",
      "durationSec": 4.392
    },
    {
      "index": 33,
      "text": "Левая голень.",
      "file": "c033.ogg",
      "durationSec": 3.648
    },
    {
      "index": 34,
      "text": "Колено.",
      "file": "c034.ogg",
      "durationSec": 2.904
    },
    {
      "index": 35,
      "text": "Бедро.",
      "file": "c035.ogg",
      "durationSec": 2.88
    },
    {
      "index": 36,
      "text": "[пауза:21]",
      "file": "c036.ogg",
      "durationSec": 4.392
    },
    {
      "index": 37,
      "text": "Левое бедро.",
      "file": "c037.ogg",
      "durationSec": 3.504
    },
    {
      "index": 38,
      "text": "Вся левая нога тяжелая и тихая.",
      "file": "c038.ogg",
      "durationSec": 6.192
    },
    {
      "index": 39,
      "text": "[пауза:23]",
      "file": "c039.ogg",
      "durationSec": 4.2
    },
    {
      "index": 40,
      "text": "Таз и низкий живот.",
      "file": "c040.ogg",
      "durationSec": 4.2
    },
    {
      "index": 41,
      "text": "Мягкий.",
      "file": "c041.ogg",
      "durationSec": 3.096
    },
    {
      "index": 42,
      "text": "[пауза:21]",
      "file": "c042.ogg",
      "durationSec": 4.392
    },
    {
      "index": 43,
      "text": "Грудная клетка поднимается и опускается.",
      "file": "c043.ogg",
      "durationSec": 6.672
    },
    {
      "index": 44,
      "text": "Пространство сердца открытое и легкое.",
      "file": "c044.ogg",
      "durationSec": 6.504
    },
    {
      "index": 45,
      "text": "[пауза:23]",
      "file": "c045.ogg",
      "durationSec": 4.2
    },
    {
      "index": 46,
      "text": "Правая рука.",
      "file": "c046.ogg",
      "durationSec": 3.528
    },
    {
      "index": 47,
      "text": "Пальцы. Ладонь. Запястье.",
      "file": "c047.ogg",
      "durationSec": 8.952
    },
    {
      "index": 48,
      "text": "[пауза:14]",
      "file": "c048.ogg",
      "durationSec": 4.728
    },
    {
      "index": 49,
      "text": "Правая рука. Локоть. Плечо.",
      "file": "c049.ogg",
      "durationSec": 9.048
    },
    {
      "index": 50,
      "text": "[пауза:21]",
      "file": "c050.ogg",
      "durationSec": 4.392
    },
    {
      "index": 51,
      "text": "Левая рука.",
      "file": "c051.ogg",
      "durationSec": 3.576
    },
    {
      "index": 52,
      "text": "Пальцы. Ладонь. Запястье.",
      "file": "c052.ogg",
      "durationSec": 8.952
    },
    {
      "index": 53,
      "text": "[пауза:14]",
      "file": "c053.ogg",
      "durationSec": 4.728
    },
    {
      "index": 54,
      "text": "Левая рука. Локоть. Плечо.",
      "file": "c054.ogg",
      "durationSec": 9.096
    },
    {
      "index": 55,
      "text": "[пауза:23]",
      "file": "c055.ogg",
      "durationSec": 4.2
    },
    {
      "index": 56,
      "text": "Горло мягкое.",
      "file": "c056.ogg",
      "durationSec": 4.08
    },
    {
      "index": 57,
      "text": "Челюсть разжалась.",
      "file": "c057.ogg",
      "durationSec": 4.008
    },
    {
      "index": 58,
      "text": "Язык отдыхает.",
      "file": "c058.ogg",
      "durationSec": 4.392
    },
    {
      "index": 59,
      "text": "[пауза:21]",
      "file": "c059.ogg",
      "durationSec": 4.392
    },
    {
      "index": 60,
      "text": "Глаза отдыхают в глазницах.",
      "file": "c060.ogg",
      "durationSec": 5.28
    },
    {
      "index": 61,
      "text": "Лоб гладкий.",
      "file": "c061.ogg",
      "durationSec": 3.72
    },
    {
      "index": 62,
      "text": "Скальп и макушка головы.",
      "file": "c062.ogg",
      "durationSec": 4.656
    },
    {
      "index": 63,
      "text": "[пауза:23]",
      "file": "c063.ogg",
      "durationSec": 4.2
    },
    {
      "index": 64,
      "text": "Ощутите все тело как одно поле тишины.",
      "file": "c064.ogg",
      "durationSec": 6.0
    },
    {
      "index": 65,
      "text": "Дыхание движется сквозь него, как тихий прилив.",
      "file": "c065.ogg",
      "durationSec": 7.08
    },
    {
      "index": 66,
      "text": "[пауза:62]",
      "file": "c066.ogg",
      "durationSec": 4.32
    },
    {
      "index": 67,
      "text": "Оставайтесь всем телом.",
      "file": "c067.ogg",
      "durationSec": 4.728
    },
    {
      "index": 68,
      "text": "[пауза: 105]",
      "file": "c068.ogg",
      "durationSec": 4.104
    },
    {
      "index": 69,
      "text": "Мягкий. Просторный. Все еще.",
      "file": "c069.ogg",
      "durationSec": 9.384
    },
    {
      "index": 70,
      "text": "[пауза:55]",
      "file": "c070.ogg",
      "durationSec": 4.8
    },
    {
      "index": 71,
      "text": "Если появляется мысль, позвольте ей пройти, как облако.",
      "file": "c071.ogg",
      "durationSec": 7.776
    },
    {
      "index": 72,
      "text": "[пауза: 50]",
      "file": "c072.ogg",
      "durationSec": 4.512
    },
    {
      "index": 73,
      "text": "Вернитесь к ощущению того, что вас держат.",
      "file": "c073.ogg",
      "durationSec": 6.84
    },
    {
      "index": 74,
      "text": "[пауза:55]",
      "file": "c074.ogg",
      "durationSec": 4.8
    },
    {
      "index": 75,
      "text": "Отдых здесь.",
      "file": "c075.ogg",
      "durationSec": 3.504
    },
    {
      "index": 76,
      "text": "Нечего решать.",
      "file": "c076.ogg",
      "durationSec": 3.792
    },
    {
      "index": 77,
      "text": "Нечего завершать.",
      "file": "c077.ogg",
      "durationSec": 4.032
    },
    {
      "index": 78,
      "text": "[пауза: 110]",
      "file": "c078.ogg",
      "durationSec": 4.32
    },
    {
      "index": 79,
      "text": "Если вы дрейфуете, это нормально.",
      "file": "c079.ogg",
      "durationSec": 5.448
    },
    {
      "index": 80,
      "text": "Если вы остаетесь в курсе, это тоже хорошо.",
      "file": "c080.ogg",
      "durationSec": 6.576
    },
    {
      "index": 81,
      "text": "Оба — отдых.",
      "file": "c081.ogg",
      "durationSec": 4.104
    },
    {
      "index": 82,
      "text": "[пауза: 130]",
      "file": "c082.ogg",
      "durationSec": 4.368
    },
    {
      "index": 83,
      "text": "Отдых.",
      "file": "c083.ogg",
      "durationSec": 2.856
    },
    {
      "index": 84,
      "text": "[пауза: 115]",
      "file": "c084.ogg",
      "durationSec": 4.536
    },
    {
      "index": 85,
      "text": "Начните снова замечать дыхание.",
      "file": "c085.ogg",
      "durationSec": 5.784
    },
    {
      "index": 86,
      "text": "Теперь немного живее.",
      "file": "c086.ogg",
      "durationSec": 4.608
    },
    {
      "index": 87,
      "text": "[пауза:23]",
      "file": "c087.ogg",
      "durationSec": 4.2
    },
    {
      "index": 88,
      "text": "Почувствуйте комнату вокруг себя.",
      "file": "c088.ogg",
      "durationSec": 5.232
    },
    {
      "index": 89,
      "text": "Звучит близко и далеко.",
      "file": "c089.ogg",
      "durationSec": 4.872
    },
    {
      "index": 90,
      "text": "[пауза:21]",
      "file": "c090.ogg",
      "durationSec": 4.392
    },
    {
      "index": 91,
      "text": "Пошевелите пальцами.",
      "file": "c091.ogg",
      "durationSec": 4.344
    },
    {
      "index": 92,
      "text": "Пошевелите пальцами ног.",
      "file": "c092.ogg",
      "durationSec": 4.536
    },
    {
      "index": 93,
      "text": "Поверните запястья и лодыжки, если хотите.",
      "file": "c093.ogg",
      "durationSec": 6.864
    },
    {
      "index": 94,
      "text": "[пауза:21]",
      "file": "c094.ogg",
      "durationSec": 4.392
    },
    {
      "index": 95,
      "text": "Сделайте глубокий вдох.",
      "file": "c095.ogg",
      "durationSec": 4.488
    },
    {
      "index": 96,
      "text": "И долгий вздох.",
      "file": "c096.ogg",
      "durationSec": 3.6
    },
    {
      "index": 97,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c097.ogg",
      "durationSec": 5.76
    },
    {
      "index": 98,
      "text": "Возвращайтесь медленно.",
      "file": "c098.ogg",
      "durationSec": 4.584
    },
    {
      "index": 99,
      "text": "Возьмите с собой немного этой тишины.",
      "file": "c099.ogg",
      "durationSec": 5.832
    }
  ]
}

  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Найдите время, чтобы приехать.",
      "file": "c001.ogg",
      "durationSec": 5.616
    },
    {
      "index": 2,
      "text": "Сядьте или лягте с поддержкой.",
      "file": "c002.ogg",
      "durationSec": 5.472
    },
    {
      "index": 3,
      "text": "Закройте глаза, если это безопасно.",
      "file": "c003.ogg",
      "durationSec": 5.832
    },
    {
      "index": 4,
      "text": "Почувствуйте контакт с землей.",
      "file": "c004.ogg",
      "durationSec": 5.4
    },
    {
      "index": 5,
      "text": "Медленный вдох.",
      "file": "c005.ogg",
      "durationSec": 3.744
    },
    {
      "index": 6,
      "text": "Более длинный выдох.",
      "file": "c006.ogg",
      "durationSec": 4.248
    },
    {
      "index": 7,
      "text": "[пауза:23]",
      "file": "c007.ogg",
      "durationSec": 4.2
    },
    {
      "index": 8,
      "text": "Снова.",
      "file": "c008.ogg",
      "durationSec": 3.0
    },
    {
      "index": 9,
      "text": "[пауза:23]",
      "file": "c009.ogg",
      "durationSec": 4.2
    },
    {
      "index": 10,
      "text": "Позвольте плечам опуститься.",
      "file": "c010.ogg",
      "durationSec": 5.04
    },
    {
      "index": 11,
      "text": "Пусть живот смягчится.",
      "file": "c011.ogg",
      "durationSec": 4.728
    },
    {
      "index": 12,
      "text": "[пауза:29]",
      "file": "c012.ogg",
      "durationSec": 4.44
    },
    {
      "index": 13,
      "text": "Откройте уши.",
      "file": "c013.ogg",
      "durationSec": 3.792
    },
    {
      "index": 14,
      "text": "Обратите внимание на ближайший звук.",
      "file": "c014.ogg",
      "durationSec": 5.712
    },
    {
      "index": 15,
      "text": "[пауза:29]",
      "file": "c015.ogg",
      "durationSec": 4.44
    },
    {
      "index": 16,
      "text": "Обратите внимание на самый дальний звук, который вы слышите.",
      "file": "c016.ogg",
      "durationSec": 7.824
    },
    {
      "index": 17,
      "text": "[пауза:29]",
      "file": "c017.ogg",
      "durationSec": 4.44
    },
    {
      "index": 18,
      "text": "Обратите внимание на тишину между звуками.",
      "file": "c018.ogg",
      "durationSec": 6.312
    },
    {
      "index": 19,
      "text": "[пауза:35]",
      "file": "c019.ogg",
      "durationSec": 4.512
    },
    {
      "index": 20,
      "text": "Звуки возникают и проходят. Вам не нужно их называть.",
      "file": "c020.ogg",
      "durationSec": 9.912
    },
    {
      "index": 21,
      "text": "Слух слышит.",
      "file": "c021.ogg",
      "durationSec": 3.768
    },
    {
      "index": 22,
      "text": "[пауза: 47]",
      "file": "c022.ogg",
      "durationSec": 4.152
    },
    {
      "index": 23,
      "text": "Когда ум блуждает, вернитесь к слушанию.",
      "file": "c023.ogg",
      "durationSec": 6.528
    },
    {
      "index": 24,
      "text": "[пауза:35]",
      "file": "c024.ogg",
      "durationSec": 4.512
    },
    {
      "index": 25,
      "text": "Включите звук собственного дыхания.",
      "file": "c025.ogg",
      "durationSec": 5.976
    },
    {
      "index": 26,
      "text": "[пауза:35]",
      "file": "c026.ogg",
      "durationSec": 4.512
    },
    {
      "index": 27,
      "text": "Отдыхайте в целом звуковом ландшафте.",
      "file": "c027.ogg",
      "durationSec": 5.688
    },
    {
      "index": 28,
      "text": "Живое поле вибрации.",
      "file": "c028.ogg",
      "durationSec": 4.512
    },
    {
      "index": 29,
      "text": "[пауза: 90]",
      "file": "c029.ogg",
      "durationSec": 4.128
    },
    {
      "index": 30,
      "text": "На прослушивании нечего решать.",
      "file": "c030.ogg",
      "durationSec": 5.16
    },
    {
      "index": 31,
      "text": "[пауза:70]",
      "file": "c031.ogg",
      "durationSec": 4.272
    },
    {
      "index": 32,
      "text": "[пауза:35]",
      "file": "c032.ogg",
      "durationSec": 4.512
    },
    {
      "index": 33,
      "text": "Начните углублять дыхание.",
      "file": "c033.ogg",
      "durationSec": 5.424
    },
    {
      "index": 34,
      "text": "Отдых здесь.",
      "file": "c034.ogg",
      "durationSec": 3.504
    },
    {
      "index": 35,
      "text": "[пауза:27]",
      "file": "c035.ogg",
      "durationSec": 4.272
    },
    {
      "index": 36,
      "text": "Почувствуйте комнату снова.",
      "file": "c036.ogg",
      "durationSec": 4.752
    },
    {
      "index": 37,
      "text": "Шевелите пальцами рук и ног.",
      "file": "c037.ogg",
      "durationSec": 4.824
    },
    {
      "index": 38,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c038.ogg",
      "durationSec": 5.76
    },
    {
      "index": 39,
      "text": "Медленно двигайтесь к тому, что будет дальше.",
      "file": "c039.ogg",
      "durationSec": 6.528
    }

{
  "id": "quit-smoking-free-10",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 330,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Эта практика для вас как для некурящего.",
      "file": "c001.ogg",
      "durationSec": 5.76
    },
    {
      "index": 2,
      "text": "Найдите удобное сидение, или лягте, если так будет лучше.",
      "file": "c002.ogg",
      "durationSec": 8.64
    },
    {
      "index": 3,
      "text": "Позвольте рукам отдохнуть.",
      "file": "c003.ogg",
      "durationSec": 4.608
    },
    {
      "index": 4,
      "text": "Расслабьте глаза, или закройте их.",
      "file": "c004.ogg",
      "durationSec": 6.048
    },
    {
      "index": 5,
      "text": "Сделайте медленный вдох.",
      "file": "c005.ogg",
      "durationSec": 4.584
    },
    {
      "index": 6,
      "text": "И более длинный выдох.",
      "file": "c006.ogg",
      "durationSec": 4.32
    },
    {
      "index": 7,
      "text": "[пауза:16]",
      "file": "c007.ogg",
      "durationSec": 4.296
    },
    {
      "index": 8,
      "text": "Почувствуйте, как тело поддерживается.",
      "file": "c008.ogg",
      "durationSec": 6.024
    },
    {
      "index": 9,
      "text": "Ничего доказывать. Никуда не спешить.",
      "file": "c009.ogg",
      "durationSec": 7.944
    },
    {
      "index": 10,
      "text": "[пауза:16]",
      "file": "c010.ogg",
      "durationSec": 4.296
    },
    {
      "index": 11,
      "text": "Мы будем работать с четкими утверждениями свободы.",
      "file": "c011.ogg",
      "durationSec": 6.912
    },
    {
      "index": 12,
      "text": "Слушайте или тихо повторяйте то, что кажется правдой.",
      "file": "c012.ogg",
      "durationSec": 7.848
    },
    {
      "index": 13,
      "text": "[пауза:18]",
      "file": "c013.ogg",
      "durationSec": 4.488
    },
    {
      "index": 14,
      "text": "Я теперь некурящий.",
      "file": "c014.ogg",
      "durationSec": 4.536
    },
    {
      "index": 15,
      "text": "[пауза:16]",
      "file": "c015.ogg",
      "durationSec": 4.296
    },
    {
      "index": 16,
      "text": "Я так счастлив избавиться от болезни никотина.",
      "file": "c016.ogg",
      "durationSec": 6.816
    },
    {
      "index": 17,
      "text": "[пауза:18]",
      "file": "c017.ogg",
      "durationSec": 4.488
    },
    {
      "index": 18,
      "text": "Курение больше не является частью моей жизни или моей идентичности.",
      "file": "c018.ogg",
      "durationSec": 8.616
    },
    {
      "index": 19,
      "text": "[пауза:18]",
      "file": "c019.ogg",
      "durationSec": 4.488
    },
    {
      "index": 20,
      "text": "Я получаю эти триггеры из-за прошлых воспоминаний или наблюдения за другими курильщиками.",
      "file": "c020.ogg",
      "durationSec": 10.488
    },
    {
      "index": 21,
      "text": "[пауза:18]",
      "file": "c021.ogg",
      "durationSec": 4.488
    },
    {
      "index": 22,
      "text": "Эти триггеры ничего не могут сделать со мной, потому что я освободился от рабства зависимости.",
      "file": "c022.ogg",
      "durationSec": 10.344
    },
    {
      "index": 23,
      "text": "[пауза:22]",
      "file": "c023.ogg",
      "durationSec": 4.08
    },
    {
      "index": 24,
      "text": "Мне жаль курящих, которые всё ещё застряли в своих обманах.",
      "file": "c024.ogg",
      "durationSec": 8.184
    },
    {
      "index": 25,
      "text": "Те, кто запутался в ужасном цикле истощения никотина, желания и повторного пополнения.",
      "file": "c025.ogg",
      "durationSec": 11.112
    },
    {
      "index": 26,
      "text": "[пауза:18]",
      "file": "c026.ogg",
      "durationSec": 4.488
    },
    {
      "index": 27,
      "text": "Я больше не страдаю так, как они.",
      "file": "c027.ogg",
      "durationSec": 5.808
    },
    {
      "index": 28,
      "text": "[пауза:14]",
      "file": "c028.ogg",
      "durationSec": 4.728
    },
    {
      "index": 29,
      "text": "Теперь я знаю правду.",
      "file": "c029.ogg",
      "durationSec": 4.2
    },
    {
      "index": 30,
      "text": "Курение абсолютно не приносит пользы.",
      "file": "c030.ogg",
      "durationSec": 5.736
    },
    {
      "index": 31,
      "text": "[пауза:18]",
      "file": "c031.ogg",
      "durationSec": 4.488
    },
    {
      "index": 32,
      "text": "Палочка для анализа мочи никогда никому не помогала, и никогда не поможет.",
      "file": "c032.ogg",
      "durationSec": 9.264
    },
    {
      "index": 33,
      "text": "[пауза:18]",
      "file": "c033.ogg",
      "durationSec": 4.488
    },
    {
      "index": 34,
      "text": "Курение создало для меня множество проблем.",
      "file": "c034.ogg",
      "durationSec": 6.0
    },
    {
      "index": 35,
      "text": "[пауза:14]",
      "file": "c035.ogg",
      "durationSec": 4.728
    },
    {
      "index": 36,
      "text": "Я принял лучшее решение в своей жизни — больше никогда не курить ни одной пuffs этого отвратительного яда.",
      "file": "c036.ogg",
      "durationSec": 12.576
    },
    {
      "index": 37,
      "text": "Это решение было окончательным.",
      "file": "c037.ogg",
      "durationSec": 5.352
    },
    {
      "index": 38,
      "text": "[пауза:22]",
      "file": "c038.ogg",
      "durationSec": 4.08
    },
    {
      "index": 39,
      "text": "Теперь я уважаю Закон о курении.",
      "file": "c039.ogg",
      "durationSec": 5.256
    },
    {
      "index": 40,
      "text": "[пауза:18]",
      "file": "c040.ogg",
      "durationSec": 4.488
    },
    {
      "index": 41,
      "text": "Теперь все мои ситуации становятся лучше.",
      "file": "c041.ogg",
      "durationSec": 6.096
    },
    {
      "index": 42,
      "text": "Я становлюсь счастливее, здоровее и увереннее.",
      "file": "c042.ogg",
      "durationSec": 7.488
    },
    {
      "index": 43,
      "text": "[пауза:22]",
      "file": "c043.ogg",
      "durationSec": 4.08
    },
    {
      "index": 44,
      "text": "Я свободен.",
      "file": "c044.ogg",
      "durationSec": 3.6
    },
    {
      "index": 45,
      "text": "[пауза:28]",
      "file": "c045.ogg",
      "durationSec": 4.44
    },
    {
      "index": 46,
      "text": "Отдохни в этой свободе несколько дыханий.",
      "file": "c046.ogg",
      "durationSec": 5.952
    },
    {
      "index": 47,
      "text": "Триггеры могут по-прежнему посещать тебя как старые воспоминания.",
      "file": "c047.ogg",
      "durationSec": 8.16
    },
    {
      "index": 48,
      "text": "Они не могут вернуть вас в рабство.",
      "file": "c048.ogg",
      "durationSec": 5.28
    },
    {
      "index": 49,
      "text": "[пауза:36]",
      "file": "c049.ogg",
      "durationSec": 4.704
    },
    {
      "index": 50,
      "text": "Я теперь некурящий.",
      "file": "c050.ogg",
      "durationSec": 4.536
    },
    {
      "index": 51,
      "text": "Я свободен.",
      "file": "c051.ogg",
      "durationSec": 3.6
    },
    {
      "index": 52,
      "text": "[пауза:28]",
      "file": "c052.ogg",
      "durationSec": 4.44
    },
    {
      "index": 53,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c053.ogg",
      "durationSec": 5.328
    },
    {
      "index": 54,
      "text": "Потрясите пальцами.",
      "file": "c054.ogg",
      "durationSec": 4.296
    },
    {
      "index": 55,
      "text": "Когда вы будете готовы, откройте глаза.",
      "file": "c055.ogg",
      "durationSec": 5.904
    },
    {
      "index": 56,
      "text": "Несите эту свободу с собой.",
      "file": "c056.ogg",
      "durationSec": 4.992
    }
  ]
}

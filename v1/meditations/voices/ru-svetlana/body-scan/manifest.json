{
  "id": "body-scan",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 175,
  "chunks": [
    {
      "index": 0,
      "text": "Мы аккуратно просканируем тело.",
      "file": "c000.ogg",
      "durationSec": 5.256
    },
    {
      "index": 1,
      "text": "Лягте или сядьте спокойно.",
      "file": "c001.ogg",
      "durationSec": 5.28
    },
    {
      "index": 2,
      "text": "Закройте глаза, если это кажется безопасным.",
      "file": "c002.ogg",
      "durationSec": 6.456
    },
    {
      "index": 3,
      "text": "Начните с макушки головы.",
      "file": "c003.ogg",
      "durationSec": 4.944
    },
    {
      "index": 4,
      "text": "Обратите внимание на любое ощущение. Тепло. Прохлада. Ничего вообще.",
      "file": "c004.ogg",
      "durationSec": 15.792
    },
    {
      "index": 5,
      "text": "Нет необходимости менять его. Просто обратите внимание.",
      "file": "c005.ogg",
      "durationSec": 9.648
    },
    {
      "index": 6,
      "text": "Мягко двигайтесь ко лбу и глазам.",
      "file": "c006.ogg",
      "durationSec": 5.568
    },
    {
      "index": 7,
      "text": "Позвольте крошечным мышцам вокруг глаз расслабиться.",
      "file": "c007.ogg",
      "durationSec": 7.128
    },
    {
      "index": 8,
      "text": "Почувствуйте челюсть. Разжимайте, если можете.",
      "file": "c008.ogg",
      "durationSec": 9.288
    },
    {
      "index": 9,
      "text": "Язык слегка покоится.",
      "file": "c009.ogg",
      "durationSec": 5.016
    },
    {
      "index": 10,
      "text": "Плечи. Они подняты? Пусть они немного осядут.",
      "file": "c010.ogg",
      "durationSec": 10.824
    },
    {
      "index": 11,
      "text": "Руки тяжелые. Руки открыты или мягкие.",
      "file": "c011.ogg",
      "durationSec": 8.88
    },
    {
      "index": 12,
      "text": "Грудная клетка поднимается и опускается при дыхании.",
      "file": "c012.ogg",
      "durationSec": 7.488
    },
    {
      "index": 13,
      "text": "Живот мягкий. Никакого принуждения.",
      "file": "c013.ogg",
      "durationSec": 8.64
    },
    {
      "index": 14,
      "text": "Бедра и таз отдыхают.",
      "file": "c014.ogg",
      "durationSec": 5.136
    },
    {
      "index": 15,
      "text": "Бедра. Колени. Нижние ноги.",
      "file": "c015.ogg",
      "durationSec": 9.36
    },
    {
      "index": 16,
      "text": "Ноги. Подошвы касаются пола или коврика.",
      "file": "c016.ogg",
      "durationSec": 8.688
    },
    {
      "index": 17,
      "text": "Теперь ощутите все тело как одно поле осознания.",
      "file": "c017.ogg",
      "durationSec": 7.296
    },
    {
      "index": 18,
      "text": "Дыхание проходит через него.",
      "file": "c018.ogg",
      "durationSec": 4.824
    },
    {
      "index": 19,
      "text": "Если появилось напряженное место, направьте туда добрый выдох.",
      "file": "c019.ogg",
      "durationSec": 8.232
    },
    {
      "index": 20,
      "text": "Задержитесь на три спокойных вдоха.",
      "file": "c020.ogg",
      "durationSec": 5.832
    },
    {
      "index": 21,
      "text": "Когда будете готовы, пошевелите пальцами рук и ног.",
      "file": "c021.ogg",
      "durationSec": 7.176
    },
    {
      "index": 22,
      "text": "Откройте глаза. Вернитесь аккуратно.",
      "file": "c022.ogg",
      "durationSec": 8.016
    }
  ]
}

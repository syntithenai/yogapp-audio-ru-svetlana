{
  "id": "canyon-gold-10",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 706,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Найдите позу, которая ничего от вас не требует.",
      "file": "c001.ogg",
      "durationSec": 6.792
    },
    {
      "index": 2,
      "text": "Сядьте или лягте с любой поддержкой, которая вам нужна.",
      "file": "c002.ogg",
      "durationSec": 7.632
    },
    {
      "index": 3,
      "text": "Пусть ваши руки будут открытыми или мягкими.",
      "file": "c003.ogg",
      "durationSec": 6.528
    },
    {
      "index": 4,
      "text": "Позвольте глазам закрыться или сохраняйте мягкий взгляд.",
      "file": "c004.ogg",
      "durationSec": 7.368
    },
    {
      "index": 5,
      "text": "Почувствуйте места, где ваше тело встречается с землей.",
      "file": "c005.ogg",
      "durationSec": 7.344
    },
    {
      "index": 6,
      "text": "Пятки, седалищные кости, затылок или длина позвоночника.",
      "file": "c006.ogg",
      "durationSec": 8.496
    },
    {
      "index": 7,
      "text": "Нечего сейчас задерживать.",
      "file": "c007.ogg",
      "durationSec": 5.04
    },
    {
      "index": 8,
      "text": "Сделайте медленный вдох через нос.",
      "file": "c008.ogg",
      "durationSec": 5.4
    },
    {
      "index": 9,
      "text": "Почувствуйте прохладу приходящего воздуха.",
      "file": "c009.ogg",
      "durationSec": 6.024
    },
    {
      "index": 10,
      "text": "И выдохните еще немного.",
      "file": "c010.ogg",
      "durationSec": 4.656
    },
    {
      "index": 11,
      "text": "Почувствуйте, как уходит тепло выдоха.",
      "file": "c011.ogg",
      "durationSec": 5.928
    },
    {
      "index": 12,
      "text": "Снова. Мягкий вдох.",
      "file": "c012.ogg",
      "durationSec": 6.264
    },
    {
      "index": 13,
      "text": "Неторопливый выдох.",
      "file": "c013.ogg",
      "durationSec": 3.912
    },
    {
      "index": 14,
      "text": "Позвольте плечам немного опуститься.",
      "file": "c014.ogg",
      "durationSec": 5.784
    },
    {
      "index": 15,
      "text": "Позвольте челюсти разжаться.",
      "file": "c015.ogg",
      "durationSec": 4.944
    },
    {
      "index": 16,
      "text": "Пусть живот будет мягким.",
      "file": "c016.ogg",
      "durationSec": 4.728
    },
    {
      "index": 17,
      "text": "Оставайтесь с тремя спокойными вдохами, как есть.",
      "file": "c017.ogg",
      "durationSec": 7.032
    },
    {
      "index": 18,
      "text": "Вдохните. Приезжать.",
      "file": "c018.ogg",
      "durationSec": 6.552
    },
    {
      "index": 19,
      "text": "Выдохните. Решить.",
      "file": "c019.ogg",
      "durationSec": 6.264
    },
    {
      "index": 20,
      "text": "Если ум блуждает, милостиво обратите на это внимание и вернитесь к этому дыханию.",
      "file": "c020.ogg",
      "durationSec": 10.224
    },
    {
      "index": 21,
      "text": "Представьте себе широкий каньон, окрашенный в мягкий золотой и розовый цвета.",
      "file": "c021.ogg",
      "durationSec": 9.408
    },
    {
      "index": 22,
      "text": "Сейчас поздний вечер. Свет щедрый.",
      "file": "c022.ogg",
      "durationSec": 7.896
    },
    {
      "index": 23,
      "text": "Тепло исходит от камня, который весь день удерживал солнце.",
      "file": "c023.ogg",
      "durationSec": 8.136
    },
    {
      "index": 24,
      "text": "Почувствуйте это лучистое тепло на голенях и тыльной стороне ладоней.",
      "file": "c024.ogg",
      "durationSec": 8.16
    },
    {
      "index": 25,
      "text": "Сухой свежий ветерок дует по дну каньона.",
      "file": "c025.ogg",
      "durationSec": 6.384
    },
    {
      "index": 26,
      "text": "Он охлаждает ваше лицо, не испытывая при этом тепла.",
      "file": "c026.ogg",
      "durationSec": 7.344
    },
    {
      "index": 27,
      "text": "Вы идете по песчаной дорожке между тихими стенами.",
      "file": "c027.ogg",
      "durationSec": 6.984
    },
    {
      "index": 28,
      "text": "Шаги шепчут. Эхо мягкое, почти вежливое.",
      "file": "c028.ogg",
      "durationSec": 9.216
    },
    {
      "index": 29,
      "text": "Почувствуйте запах выжженной на солнце земли, шалфея и чистой пыли.",
      "file": "c029.ogg",
      "durationSec": 8.952
    },
    {
      "index": 30,
      "text": "Положите ладонь на гладкий камень.",
      "file": "c030.ogg",
      "durationSec": 5.232
    },
    {
      "index": 31,
      "text": "Почувствуйте, как там хранится дневной свет — устойчивое, терпеливое тепло.",
      "file": "c031.ogg",
      "durationSec": 9.72
    },
    {
      "index": 32,
      "text": "Лента тени дарит прохладу на несколько шагов.",
      "file": "c032.ogg",
      "durationSec": 6.336
    },
    {
      "index": 33,
      "text": "Потом снова солнце, согревающее плечи, словно шаль.",
      "file": "c033.ogg",
      "durationSec": 7.752
    },
    {
      "index": 34,
      "text": "Вы подходите к месту, где открывается каньон.",
      "file": "c034.ogg",
      "durationSec": 6.648
    },
    {
      "index": 35,
      "text": "Сядьте на плоский камень, все еще сохраняющий золотое тепло.",
      "file": "c035.ogg",
      "durationSec": 7.896
    },
    {
      "index": 36,
      "text": "Почувствуйте, как он поднимается через ваше сиденье и позвоночник.",
      "file": "c036.ogg",
      "durationSec": 8.544
    },
    {
      "index": 37,
      "text": "Почувствуйте свежий воздух высоты с каждым вдохом.",
      "file": "c037.ogg",
      "durationSec": 6.84
    },
    {
      "index": 38,
      "text": "Высоко над головой ястреб медленно и неторопливо кружит.",
      "file": "c038.ogg",
      "durationSec": 7.512
    },
    {
      "index": 39,
      "text": "Вы заимствуете эту неторопливость.",
      "file": "c039.ogg",
      "durationSec": 5.52
    },
    {
      "index": 40,
      "text": "Дыхание длинное. Тело тяжелое. Разум широкий, как небо между стенами.",
      "file": "c040.ogg",
      "durationSec": 14.16
    },
    {
      "index": 41,
      "text": "Наблюдайте, как тень поднимается на дальнюю скалу, когда солнце садится.",
      "file": "c041.ogg",
      "durationSec": 9.384
    },
    {
      "index": 42,
      "text": "Цвета становятся глубже. Тепло смягчается, но не исчезает.",
      "file": "c042.ogg",
      "durationSec": 10.632
    },
    {
      "index": 43,
      "text": "Ветер теперь пахнет прохладнее, вечерней свежестью.",
      "file": "c043.ogg",
      "durationSec": 7.32
    },
    {
      "index": 44,
      "text": "Обхватите себя руками на мгновение.",
      "file": "c044.ogg",
      "durationSec": 5.904
    },
    {
      "index": 45,
      "text": "Тепло собственного тела. Тепло камня. Достаточно.",
      "file": "c045.ogg",
      "durationSec": 11.448
    },
    {
      "index": 46,
      "text": "Осторожно откиньтесь на спину и наблюдайте за первой тихой звездой.",
      "file": "c046.ogg",
      "durationSec": 8.232
    },
    {
      "index": 47,
      "text": "Каньон держит вас, как рука, сложенная в чашечку, держит воду — мягко, без пролития.",
      "file": "c047.ogg",
      "durationSec": 12.168
    },
    {
      "index": 48,
      "text": "Покойся с этим удерживаемым чувством.",
      "file": "c048.ogg",
      "durationSec": 5.592
    },
    {
      "index": 49,
      "text": "Обратите внимание на последнее тепло, поднимающееся от камня в охлаждающий воздух.",
      "file": "c049.ogg",
      "durationSec": 9.984
    },
    {
      "index": 50,
      "text": "Обратите внимание, как ветер теперь пахнет вечером, пылью и шалфеем.",
      "file": "c050.ogg",
      "durationSec": 9.36
    },
    {
      "index": 51,
      "text": "Твое дыхание замедлилось, чтобы соответствовать тишине.",
      "file": "c051.ogg",
      "durationSec": 7.68
    },
    {
      "index": 52,
      "text": "Если напряжение во бровях остается, смягчите его этим золотым светом.",
      "file": "c052.ogg",
      "durationSec": 9.24
    },
    {
      "index": 53,
      "text": "Если челюсть напряжена, дайте ей свободно свисать при легком повороте ястреба.",
      "file": "c053.ogg",
      "durationSec": 9.744
    },
    {
      "index": 54,
      "text": "Оставайтесь еще на несколько циклов теплого камня и свежего воздуха.",
      "file": "c054.ogg",
      "durationSec": 8.472
    },
    {
      "index": 55,
      "text": "Вы не опоздали. Вы здесь.",
      "file": "c055.ogg",
      "durationSec": 6.816
    },
    {
      "index": 56,
      "text": "Пройдите еще несколько шагов по теплому песку между стенами каньона.",
      "file": "c056.ogg",
      "durationSec": 8.616
    },
    {
      "index": 57,
      "text": "Твоя тень тянется долго и спокойно.",
      "file": "c057.ogg",
      "durationSec": 5.952
    },
    {
      "index": 58,
      "text": "Снова положите обе ладони на камень.",
      "file": "c058.ogg",
      "durationSec": 6.024
    },
    {
      "index": 59,
      "text": "Тепло проникает в руки как благословение, которое не нужно заслужить.",
      "file": "c059.ogg",
      "durationSec": 9.0
    },
    {
      "index": 60,
      "text": "Ветер продувает прохладой твои волосы.",
      "file": "c060.ogg",
      "durationSec": 6.024
    },
    {
      "index": 61,
      "text": "Аромат шалфея. Аромат пыли. Аромат Солнца.",
      "file": "c061.ogg",
      "durationSec": 11.52
    },
    {
      "index": 62,
      "text": "Сидеть. Колени мягкие. Позвоночник легкий.",
      "file": "c062.ogg",
      "durationSec": 11.424
    },
    {
      "index": 63,
      "text": "Наблюдайте, как цвет становится глубже от золотого к розовому.",
      "file": "c063.ogg",
      "durationSec": 8.544
    },
    {
      "index": 64,
      "text": "Тепло смягчает. Свежесть увеличивается. Баланс сохраняется.",
      "file": "c064.ogg",
      "durationSec": 13.248
    },
    {
      "index": 65,
      "text": "Так вечера учат нервную систему переключаться на пониженную передачу.",
      "file": "c065.ogg",
      "durationSec": 8.568
    },
    {
      "index": 66,
      "text": "Заимствуйте урок без усилий.",
      "file": "c066.ogg",
      "durationSec": 5.256
    },
    {
      "index": 67,
      "text": "Три вздоха для камня.",
      "file": "c067.ogg",
      "durationSec": 4.344
    },
    {
      "index": 68,
      "text": "Трое для неба.",
      "file": "c068.ogg",
      "durationSec": 3.648
    },
    {
      "index": 69,
      "text": "Три для спокойного животного вашего собственного тела, отдыхающего.",
      "file": "c069.ogg",
      "durationSec": 8.496
    },
    {
      "index": 70,
      "text": "Теперь оставьте историю в покое и оставайтесь сенсацией.",
      "file": "c070.ogg",
      "durationSec": 7.8
    },
    {
      "index": 71,
      "text": "Вдохните свежесть этого места.",
      "file": "c071.ogg",
      "durationSec": 5.448
    },
    {
      "index": 72,
      "text": "Вдохните его тепло и тишину.",
      "file": "c072.ogg",
      "durationSec": 5.232
    },
    {
      "index": 73,
      "text": "Вдохните.",
      "file": "c073.ogg",
      "durationSec": 3.36
    },
    {
      "index": 74,
      "text": "Выдохните.",
      "file": "c074.ogg",
      "durationSec": 3.336
    },
    {
      "index": 75,
      "text": "Снова. Мягкий вдох.",
      "file": "c075.ogg",
      "durationSec": 6.264
    },
    {
      "index": 76,
      "text": "Более длинный выдох.",
      "file": "c076.ogg",
      "durationSec": 4.248
    },
    {
      "index": 77,
      "text": "Почувствуйте тело, удерживаемое землей этого воображаемого мира.",
      "file": "c077.ogg",
      "durationSec": 8.688
    },
    {
      "index": 78,
      "text": "Вдохните.",
      "file": "c078.ogg",
      "durationSec": 3.36
    },
    {
      "index": 79,
      "text": "Выдохните.",
      "file": "c079.ogg",
      "durationSec": 3.336
    },
    {
      "index": 80,
      "text": "Если мысли блуждают, вернитесь к теплу на коже.",
      "file": "c080.ogg",
      "durationSec": 6.696
    },
    {
      "index": 81,
      "text": "Или охладить воздух у носа.",
      "file": "c081.ogg",
      "durationSec": 5.016
    },
    {
      "index": 82,
      "text": "Вдохните.",
      "file": "c082.ogg",
      "durationSec": 3.36
    },
    {
      "index": 83,
      "text": "Выдохните.",
      "file": "c083.ogg",
      "durationSec": 3.336
    },
    {
      "index": 84,
      "text": "Вдохните.",
      "file": "c084.ogg",
      "durationSec": 3.36
    },
    {
      "index": 85,
      "text": "Выдохните.",
      "file": "c085.ogg",
      "durationSec": 3.336
    },
    {
      "index": 86,
      "text": "Оставаться. Смягчить. Продолжать.",
      "file": "c086.ogg",
      "durationSec": 9.648
    },
    {
      "index": 87,
      "text": "Вдохните.",
      "file": "c087.ogg",
      "durationSec": 3.36
    },
    {
      "index": 88,
      "text": "Выдохните.",
      "file": "c088.ogg",
      "durationSec": 3.336
    },
    {
      "index": 89,
      "text": "Еще один легкий цикл.",
      "file": "c089.ogg",
      "durationSec": 5.016
    },
    {
      "index": 90,
      "text": "Вдохните.",
      "file": "c090.ogg",
      "durationSec": 3.36
    },
    {
      "index": 91,
      "text": "Выдохните.",
      "file": "c091.ogg",
      "durationSec": 3.336
    },
    {
      "index": 92,
      "text": "Задержитесь в этом чувстве еще на несколько вдохов.",
      "file": "c092.ogg",
      "durationSec": 6.792
    },
    {
      "index": 93,
      "text": "Тепло. Мягкость. Достаточно.",
      "file": "c093.ogg",
      "durationSec": 9.36
    },
    {
      "index": 94,
      "text": "Вы можете вернуться в это место, когда вам это понадобится.",
      "file": "c094.ogg",
      "durationSec": 7.32
    },
    {
      "index": 95,
      "text": "Оно живет в вашем внимании, а не только в воображении.",
      "file": "c095.ogg",
      "durationSec": 7.608
    },
    {
      "index": 96,
      "text": "Начните углублять дыхание.",
      "file": "c096.ogg",
      "durationSec": 5.424
    },
    {
      "index": 97,
      "text": "Снова почувствуйте комнату вокруг себя.",
      "file": "c097.ogg",
      "durationSec": 5.88
    },
    {
      "index": 98,
      "text": "Пошевелите пальцами. Смягчите пальцы ног.",
      "file": "c098.ogg",
      "durationSec": 8.592
    },
    {
      "index": 99,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c099.ogg",
      "durationSec": 5.76
    },
    {
      "index": 100,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c100.ogg",
      "durationSec": 5.328
    },
    {
      "index": 101,
      "text": "Несите это спокойствие во все, что произойдет дальше.",
      "file": "c101.ogg",
      "durationSec": 7.464
    }
  ]
}

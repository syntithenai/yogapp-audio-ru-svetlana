  "totalSec": 141,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Найдите удобное сиденье или лягте, если вам так удобнее.",
      "file": "c001.ogg",
      "durationSec": 8.256
    },
    {
      "index": 2,
      "text": "Дайте рукам отдохнуть.",
      "file": "c002.ogg",
      "durationSec": 4.464
    },
    {
      "index": 3,
      "text": "Смягчите глаза или закройте их.",
      "file": "c003.ogg",
      "durationSec": 5.664
    },
    {
      "index": 4,
      "text": "Сделайте медленный вдох.",
      "file": "c004.ogg",
      "durationSec": 4.584
    },
    {
      "index": 5,
      "text": "И более длинный выдох.",
      "file": "c005.ogg",
      "durationSec": 4.32
    },
    {
      "index": 6,
      "text": "Не нужно притворяться, что это было легко.",
      "file": "c006.ogg",
      "durationSec": 5.856
    },
    {
      "index": 7,
      "text": "Пусть правда об усталости будет признана.",
      "file": "c007.ogg",
      "durationSec": 5.784
    },
    {
      "index": 8,
      "text": "[пауза:31]",
      "file": "c008.ogg",
      "durationSec": 4.584
    },
    {
      "index": 9,
      "text": "Дышите осторожно.",
      "file": "c009.ogg",
      "durationSec": 4.368
    },
    {
      "index": 10,
      "text": "Выдохните требование, чтобы все было в порядке.",
      "file": "c010.ogg",
      "durationSec": 6.816
    },
    {
      "index": 11,
      "text": "[пауза:31]",
      "file": "c011.ogg",
      "durationSec": 4.584
    },
    {
      "index": 12,
      "text": "Позвольте мне быть нежным с самим собой сегодня вечером.",
      "file": "c012.ogg",
      "durationSec": 6.936
    },
    {
      "index": 13,
      "text": "Пусть я отдохну, как есть.",
      "file": "c013.ogg",
      "durationSec": 5.016
    },
    {
      "index": 14,
      "text": "[пауза:31]",
      "file": "c014.ogg",
      "durationSec": 4.584
    },
    {
      "index": 15,
      "text": "Пусть завтра попросит только то, что я могу дать.",
      "file": "c015.ogg",
      "durationSec": 6.888
    },
    {
      "index": 16,
      "text": "[пауза:31]",
      "file": "c016.ogg",
      "durationSec": 4.584
    },
    {
      "index": 17,
      "text": "Почувствуйте поддержку тела.",
      "file": "c017.ogg",
      "durationSec": 4.824
    },
    {
      "index": 18,
      "text": "Больше ничего не требуется в эту минуту.",
      "file": "c018.ogg",
      "durationSec": 5.64
    },
    {
      "index": 19,
      "text": "[пауза: 45]",
      "file": "c019.ogg",
      "durationSec": 4.296
    },
    {
      "index": 20,
      "text": "Положите руку на сердце, если это поможет.",
      "file": "c020.ogg",
      "durationSec": 6.12
    },
    {
      "index": 21,
      "text": "Вы справились.",
      "file": "c021.ogg",
      "durationSec": 3.504
    },
    {
      "index": 22,
      "text": "[пауза:38]",
      "file": "c022.ogg",
      "durationSec": 4.584
    },
    {
      "index": 23,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c023.ogg",
      "durationSec": 5.328
    },
    {
      "index": 24,
      "text": "Пошевелите пальцами.",
      "file": "c024.ogg",
      "durationSec": 4.344
    },
    {
      "index": 25,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c025.ogg",
      "durationSec": 5.76
    },
    {
      "index": 26,
      "text": "Носите немного этого с собой.",
      "file": "c026.ogg",
      "durationSec": 5.16
    }
  ]
}

{
  "id": "forest-clearing-5",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 381,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Сядьте поудобнее или лягте, если так удобнее.",
      "file": "c001.ogg",
      "durationSec": 7.488
    },
    {
      "index": 2,
      "text": "Дайте рукам отдохнуть.",
      "file": "c002.ogg",
      "durationSec": 4.464
    },
    {
      "index": 3,
      "text": "Позвольте глазам закрыться или смягчите взгляд.",
      "file": "c003.ogg",
      "durationSec": 6.6
    },
    {
      "index": 4,
      "text": "Обратите внимание на вес вашего тела.",
      "file": "c004.ogg",
      "durationSec": 5.976
    },
    {
      "index": 5,
      "text": "Сделайте медленный вдох через нос.",
      "file": "c005.ogg",
      "durationSec": 5.4
    },
    {
      "index": 6,
      "text": "И более длинный и легкий выдох.",
      "file": "c006.ogg",
      "durationSec": 5.064
    },
    {
      "index": 7,
      "text": "Снова. Мягкий вдох.",
      "file": "c007.ogg",
      "durationSec": 6.264
    },
    {
      "index": 8,
      "text": "Мягкий выдох.",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
      "text": "Если мысли блуждают, это нормально. Вернитесь к дыханию.",
      "file": "c009.ogg",
      "durationSec": 10.032
    },
    {
      "index": 10,
      "text": "Теперь представьте себе дорогу под мягкой опавшей листвой.",
      "file": "c010.ogg",
      "durationSec": 7.416
    },
    {
      "index": 11,
      "text": "Вы идете не торопясь в тихий лес.",
      "file": "c011.ogg",
      "durationSec": 5.16
    },
    {
      "index": 12,
      "text": "Пятнистый свет скользит по вашим предплечьям.",
      "file": "c012.ogg",
      "durationSec": 6.264
    },
    {
      "index": 13,
      "text": "Почувствуйте нежное тепло солнца везде, где оно находит кожу.",
      "file": "c013.ogg",
      "durationSec": 8.208
    },
    {
      "index": 14,
      "text": "Прохладная свежесть разносится ветерком между деревьями.",
      "file": "c014.ogg",
      "durationSec": 7.296
    },
    {
      "index": 15,
      "text": "Запах зеленой земли, коры и чистой минеральной влаги.",
      "file": "c015.ogg",
      "durationSec": 7.776
    },
    {
      "index": 16,
      "text": "Дорога выходит на небольшую полянку.",
      "file": "c016.ogg",
      "durationSec": 5.784
    },
    {
      "index": 17,
      "text": "Мох укрывает упавшее бревно. Вы сидите.",
      "file": "c017.ogg",
      "durationSec": 8.376
    },
    {
      "index": 18,
      "text": "Лучи солнечного света в центре подобны тихому золоту.",
      "file": "c018.ogg",
      "durationSec": 7.416
    },
    {
      "index": 19,
      "text": "Почувствуйте это тепло на своем лице, медленное и доброе.",
      "file": "c019.ogg",
      "durationSec": 7.896
    },
    {
      "index": 20,
      "text": "Ветер касается твоих волос и охлаждает виски.",
      "file": "c020.ogg",
      "durationSec": 7.008
    },
    {
      "index": 21,
      "text": "Пение птиц доносится издалека, а затем стихает.",
      "file": "c021.ogg",
      "durationSec": 7.776
    },
    {
      "index": 22,
      "text": "Ваше дыхание соответствует тишине листьев.",
      "file": "c022.ogg",
      "durationSec": 6.336
    },
    {
      "index": 23,
      "text": "Вдохните свежесть. Выдохните остатки спешки.",
      "file": "c023.ogg",
      "durationSec": 9.312
    },
    {
      "index": 24,
      "text": "Обратите внимание, насколько безопасной кажется земля под вами.",
      "file": "c024.ogg",
      "durationSec": 8.352
    },
    {
      "index": 25,
      "text": "Каким широким кажется небо над пологом.",
      "file": "c025.ogg",
      "durationSec": 5.832
    },
    {
      "index": 26,
      "text": "Жук неторопливо пересекает освещенный солнцем участок коры.",
      "file": "c026.ogg",
      "durationSec": 7.848
    },
    {
      "index": 27,
      "text": "Тебе негде быть, кроме как здесь.",
      "file": "c027.ogg",
      "durationSec": 5.664
    },
    {
      "index": 28,
      "text": "Тепло снова окутывает твои закрытые веки.",
      "file": "c028.ogg",
      "durationSec": 6.504
    },
    {
      "index": 29,
      "text": "Прохладный воздух проскальзывает под воротник, как добрая рука.",
      "file": "c029.ogg",
      "durationSec": 8.112
    },
    {
      "index": 30,
      "text": "Оставайся с теплом на щеках.",
      "file": "c030.ogg",
      "durationSec": 5.064
    },
    {
      "index": 31,
      "text": "При выдохе держите прохладный воздух на губах.",
      "file": "c031.ogg",
      "durationSec": 6.216
    },
    {
      "index": 32,
      "text": "Эта поляна ничего не требует. Оно просто удерживает вас.",
      "file": "c032.ogg",
      "durationSec": 9.648
    },
    {
      "index": 33,
      "text": "Позвольте еще одному дыханию дойти до живота.",
      "file": "c033.ogg",
      "durationSec": 6.264
    },
    {
      "index": 34,
      "text": "И снова уйти, мягкий, как листья.",
      "file": "c034.ogg",
      "durationSec": 6.84
    },
    {
      "index": 35,
      "text": "Медленно побродите своим вниманием по краю поляны.",
      "file": "c035.ogg",
      "durationSec": 6.84
    },
    {
      "index": 36,
      "text": "Папоротник. Тень. Бледный гриб у основания пня.",
      "file": "c036.ogg",
      "durationSec": 10.896
    },
    {
      "index": 37,
      "text": "Все ярко, потому что ты не торопишься.",
      "file": "c037.ogg",
      "durationSec": 5.808
    },
    {
      "index": 38,
      "text": "Снова почувствуйте солнечное тепло там, где оно падает на колено.",
      "file": "c038.ogg",
      "durationSec": 8.904
    },
    {
      "index": 39,
      "text": "Почувствуйте прохладу ветерка там, где он скользит по горлу.",
      "file": "c039.ogg",
      "durationSec": 7.632
    },
    {
      "index": 40,
      "text": "Ты можешь остаться здесь на весь день. На данный момент достаточно нескольких вдохов.",
      "file": "c040.ogg",
      "durationSec": 11.832
    },
    {
      "index": 41,
      "text": "Теперь отдохните некоторое время в одиночестве.",
      "file": "c041.ogg",
      "durationSec": 6.12
    },
    {
      "index": 42,
      "text": "Медленно вдохните.",
      "file": "c042.ogg",
      "durationSec": 4.2
    },
    {
      "index": 43,
      "text": "Медленно выдохните.",
      "file": "c043.ogg",
      "durationSec": 4.248
    },
    {
      "index": 44,
      "text": "Вдохните.",
      "file": "c044.ogg",
      "durationSec": 3.36
    },
    {
      "index": 45,
      "text": "Выдохните.",
      "file": "c045.ogg",
      "durationSec": 3.336
    },
    {
      "index": 46,
      "text": "Почувствуйте тепло везде, где тепло телу.",
      "file": "c046.ogg",
      "durationSec": 6.36
    },
    {
      "index": 47,
      "text": "Почувствуйте прохладу там, где воздух прохладный.",
      "file": "c047.ogg",
      "durationSec": 6.912
    },
    {
      "index": 48,
      "text": "Вдохните.",
      "file": "c048.ogg",
      "durationSec": 3.36
    },
    {
      "index": 49,
      "text": "Выдохните.",
      "file": "c049.ogg",
      "durationSec": 3.336
    },
    {
      "index": 50,
      "text": "Некуда идти. Нечего исправлять.",
      "file": "c050.ogg",
      "durationSec": 7.992
    },
    {
      "index": 51,
      "text": "Вдохните.",
      "file": "c051.ogg",
      "durationSec": 3.36
    },
    {
      "index": 52,
      "text": "Выдохните.",
      "file": "c052.ogg",
      "durationSec": 3.336
    },
    {
      "index": 53,
      "text": "Отдохните здесь и сделайте несколько спокойных вдохов.",
      "file": "c053.ogg",
      "durationSec": 7.272
    },
    {
      "index": 54,
      "text": "Знайте, что вы можете вернуться в это место в любое время.",
      "file": "c054.ogg",
      "durationSec": 7.68
    },
    {
      "index": 55,
      "text": "Когда будете готовы, сделайте глубокий вдох.",
      "file": "c055.ogg",
      "durationSec": 6.432
    },
    {
      "index": 56,
      "text": "Шевелите пальцами рук и ног.",
      "file": "c056.ogg",
      "durationSec": 4.824
    },
    {
      "index": 57,
      "text": "Тихо откройте глаза.",
      "file": "c057.ogg",
      "durationSec": 4.152
    },
    {
      "index": 58,
      "text": "Носите с собой частичку этого мира.",
      "file": "c058.ogg",
      "durationSec": 6.024
    }
  ]
}

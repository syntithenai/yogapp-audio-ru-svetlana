{
  "id": "cove-shore-5",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 386,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Сядьте поудобнее или лягте, если так удобнее.",
      "file": "c001.ogg",
      "durationSec": 7.488
    },
    {
      "index": 2,
      "text": "Дайте рукам отдохнуть.",
      "file": "c002.ogg",
      "durationSec": 4.464
    },
    {
      "index": 3,
      "text": "Позвольте глазам закрыться или смягчите взгляд.",
      "file": "c003.ogg",
      "durationSec": 6.6
    },
    {
      "index": 4,
      "text": "Обратите внимание на вес вашего тела.",
      "file": "c004.ogg",
      "durationSec": 5.976
    },
    {
      "index": 5,
      "text": "Сделайте медленный вдох через нос.",
      "file": "c005.ogg",
      "durationSec": 5.4
    },
    {
      "index": 6,
      "text": "И более длинный и легкий выдох.",
      "file": "c006.ogg",
      "durationSec": 5.064
    },
    {
      "index": 7,
      "text": "Снова. Мягкий вдох.",
      "file": "c007.ogg",
      "durationSec": 6.264
    },
    {
      "index": 8,
      "text": "Мягкий выдох.",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
      "text": "Если мысли блуждают, это нормально. Вернитесь к дыханию.",
      "file": "c009.ogg",
      "durationSec": 10.032
    },
    {
      "index": 10,
      "text": "Представьте, как вы приближаетесь к защищенной бухте.",
      "file": "c010.ogg",
      "durationSec": 7.344
    },
    {
      "index": 11,
      "text": "Скалы огибают мягкий светлый песок.",
      "file": "c011.ogg",
      "durationSec": 5.976
    },
    {
      "index": 12,
      "text": "Море движется низкими терпеливыми волнами.",
      "file": "c012.ogg",
      "durationSec": 6.336
    },
    {
      "index": 13,
      "text": "Мягкое солнце согревает верхнюю часть ваших плеч.",
      "file": "c013.ogg",
      "durationSec": 7.176
    },
    {
      "index": 14,
      "text": "Соленый ветерок охлаждает губы и веки.",
      "file": "c014.ogg",
      "durationSec": 6.504
    },
    {
      "index": 15,
      "text": "Почувствуйте свежесть этого воздуха, наполняющую вашу грудь.",
      "file": "c015.ogg",
      "durationSec": 8.352
    },
    {
      "index": 16,
      "text": "Идите к ватерлинии. Мокрый песок обнимает ваши ноги.",
      "file": "c016.ogg",
      "durationSec": 9.696
    },
    {
      "index": 17,
      "text": "Прохладная пена касается лодыжек и ускользает.",
      "file": "c017.ogg",
      "durationSec": 6.888
    },
    {
      "index": 18,
      "text": "Ритм простой. Приезжать. Смягчить. Оставлять.",
      "file": "c018.ogg",
      "durationSec": 13.2
    },
    {
      "index": 19,
      "text": "Сядьте там, где под вами теплый песок.",
      "file": "c019.ogg",
      "durationSec": 6.24
    },
    {
      "index": 20,
      "text": "Откиньтесь назад на руки. Почувствуйте зернистое тепло.",
      "file": "c020.ogg",
      "durationSec": 9.6
    },
    {
      "index": 21,
      "text": "Слушайте тишину и шум бухты.",
      "file": "c021.ogg",
      "durationSec": 5.568
    },
    {
      "index": 22,
      "text": "Запах соли, солнца и чистого камня.",
      "file": "c022.ogg",
      "durationSec": 6.528
    },
    {
      "index": 23,
      "text": "Тепло на вашей коже. Прохлада в каждом вдохе.",
      "file": "c023.ogg",
      "durationSec": 8.52
    },
    {
      "index": 24,
      "text": "Вдали сверкает свет, похожий на тихий смех.",
      "file": "c024.ogg",
      "durationSec": 6.984
    },
    {
      "index": 25,
      "text": "Вам не нужно гоняться за ним. Оно уже здесь.",
      "file": "c025.ogg",
      "durationSec": 8.184
    },
    {
      "index": 26,
      "text": "Волна достигает большего, охлаждает пальцы ног, а затем отступает.",
      "file": "c026.ogg",
      "durationSec": 9.432
    },
    {
      "index": 27,
      "text": "Теплый песок восстанавливает ваши ноги.",
      "file": "c027.ogg",
      "durationSec": 5.88
    },
    {
      "index": 28,
      "text": "Позвольте вашему дыханию двигаться вместе с волнами — медленнее вдыхайте, дольше выдыхайте.",
      "file": "c028.ogg",
      "durationSec": 10.464
    },
    {
      "index": 29,
      "text": "Мир – это сама бухта. Вы находитесь внутри него.",
      "file": "c029.ogg",
      "durationSec": 9.0
    },
    {
      "index": 30,
      "text": "Сосредоточьте внимание на тепле между лопатками.",
      "file": "c030.ogg",
      "durationSec": 6.768
    },
    {
      "index": 31,
      "text": "И на свежем соленом воздухе на кончике носа.",
      "file": "c031.ogg",
      "durationSec": 6.48
    },
    {
      "index": 32,
      "text": "Обрисуйте линию утеса с мягким воображением.",
      "file": "c032.ogg",
      "durationSec": 6.624
    },
    {
      "index": 33,
      "text": "Камень, согретый днем. Тень прохладная в складках.",
      "file": "c033.ogg",
      "durationSec": 8.976
    },
    {
      "index": 34,
      "text": "Рядом находится приливной бассейн, в котором находится крошечный чистый мир.",
      "file": "c034.ogg",
      "durationSec": 9.312
    },
    {
      "index": 35,
      "text": "Вам не нужно наклоняться. Достаточно знать, что это есть.",
      "file": "c035.ogg",
      "durationSec": 10.464
    },
    {
      "index": 36,
      "text": "Еще одна волна. Классные лодыжки. Теплый песок. Мягкое дыхание.",
      "file": "c036.ogg",
      "durationSec": 15.96
    },
    {
      "index": 37,
      "text": "Бухта продолжает предлагать ту же простую доброту.",
      "file": "c037.ogg",
      "durationSec": 6.912
    },
    {
      "index": 38,
      "text": "Получите его еще раз, прежде чем уйти.",
      "file": "c038.ogg",
      "durationSec": 6.024
    },
    {
      "index": 39,
      "text": "Теперь отдохните некоторое время в одиночестве.",
      "file": "c039.ogg",
      "durationSec": 6.12
    },
    {
      "index": 40,
      "text": "Медленно вдохните.",
      "file": "c040.ogg",
      "durationSec": 4.2
    },
    {
      "index": 41,
      "text": "Медленно выдохните.",
      "file": "c041.ogg",
      "durationSec": 4.248
    },
    {
      "index": 42,
      "text": "Вдохните.",
      "file": "c042.ogg",
      "durationSec": 3.36
    },
    {
      "index": 43,
      "text": "Выдохните.",
      "file": "c043.ogg",
      "durationSec": 3.336
    },
    {
      "index": 44,
      "text": "Почувствуйте тепло везде, где тепло телу.",
      "file": "c044.ogg",
      "durationSec": 6.36
    },
    {
      "index": 45,
      "text": "Почувствуйте прохладу там, где воздух прохладный.",
      "file": "c045.ogg",
      "durationSec": 6.912
    },
    {
      "index": 46,
      "text": "Вдохните.",
      "file": "c046.ogg",
      "durationSec": 3.36
    },
    {
      "index": 47,
      "text": "Выдохните.",
      "file": "c047.ogg",
      "durationSec": 3.336
    },
    {
      "index": 48,
      "text": "Некуда идти. Нечего исправлять.",
      "file": "c048.ogg",
      "durationSec": 7.992
    },
    {
      "index": 49,
      "text": "Вдохните.",
      "file": "c049.ogg",
      "durationSec": 3.36
    },
    {
      "index": 50,
      "text": "Выдохните.",
      "file": "c050.ogg",
      "durationSec": 3.336
    },
    {
      "index": 51,
      "text": "Отдохните здесь и сделайте несколько спокойных вдохов.",
      "file": "c051.ogg",
      "durationSec": 7.272
    },
    {
      "index": 52,
      "text": "Знайте, что вы можете вернуться в это место в любое время.",
      "file": "c052.ogg",
      "durationSec": 7.68
    },
    {
      "index": 53,
      "text": "Когда будете готовы, сделайте глубокий вдох.",
      "file": "c053.ogg",
      "durationSec": 6.432
    },
    {
      "index": 54,
      "text": "Шевелите пальцами рук и ног.",
      "file": "c054.ogg",
      "durationSec": 4.824
    },
    {
      "index": 55,
      "text": "Тихо откройте глаза.",
      "file": "c055.ogg",
      "durationSec": 4.152
    },
    {
      "index": 56,
      "text": "Носите с собой частичку этого мира.",
      "file": "c056.ogg",
      "durationSec": 6.024
    }
  ]
}

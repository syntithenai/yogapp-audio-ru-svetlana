{
  "id": "lake-wander-10",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 818,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Найдите позу, которая ничего от вас не требует.",
      "file": "c001.ogg",
      "durationSec": 6.792
    },
    {
      "index": 2,
      "text": "Сядьте или лягте с любой поддержкой, которая вам нужна.",
      "file": "c002.ogg",
      "durationSec": 7.632
    },
    {
      "index": 3,
      "text": "Пусть ваши руки будут открытыми или мягкими.",
      "file": "c003.ogg",
      "durationSec": 6.528
    },
    {
      "index": 4,
      "text": "Позвольте глазам закрыться или сохраняйте мягкий взгляд.",
      "file": "c004.ogg",
      "durationSec": 7.368
    },
    {
      "index": 5,
      "text": "Почувствуйте места, где ваше тело встречается с землей.",
      "file": "c005.ogg",
      "durationSec": 7.344
    },
    {
      "index": 6,
      "text": "Пятки, седалищные кости, затылок или длина позвоночника.",
      "file": "c006.ogg",
      "durationSec": 8.496
    },
    {
      "index": 7,
      "text": "Нечего сейчас задерживать.",
      "file": "c007.ogg",
      "durationSec": 5.04
    },
    {
      "index": 8,
      "text": "Сделайте медленный вдох через нос.",
      "file": "c008.ogg",
      "durationSec": 5.4
    },
    {
      "index": 9,
      "text": "Почувствуйте прохладу приходящего воздуха.",
      "file": "c009.ogg",
      "durationSec": 6.024
    },
    {
      "index": 10,
      "text": "И выдохните еще немного.",
      "file": "c010.ogg",
      "durationSec": 4.656
    },
    {
      "index": 11,
      "text": "Почувствуйте, как уходит тепло выдоха.",
      "file": "c011.ogg",
      "durationSec": 5.928
    },
    {
      "index": 12,
      "text": "Снова. Мягкий вдох.",
      "file": "c012.ogg",
      "durationSec": 6.264
    },
    {
      "index": 13,
      "text": "Неторопливый выдох.",
      "file": "c013.ogg",
      "durationSec": 3.912
    },
    {
      "index": 14,
      "text": "Позвольте плечам немного опуститься.",
      "file": "c014.ogg",
      "durationSec": 5.784
    },
    {
      "index": 15,
      "text": "Позвольте челюсти разжаться.",
      "file": "c015.ogg",
      "durationSec": 4.944
    },
    {
      "index": 16,
      "text": "Пусть живот будет мягким.",
      "file": "c016.ogg",
      "durationSec": 4.728
    },
    {
      "index": 17,
      "text": "Оставайтесь с тремя спокойными вдохами, как есть.",
      "file": "c017.ogg",
      "durationSec": 7.032
    },
    {
      "index": 18,
      "text": "Вдохните. Приезжать.",
      "file": "c018.ogg",
      "durationSec": 6.552
    },
    {
      "index": 19,
      "text": "Выдохните. Решить.",
      "file": "c019.ogg",
      "durationSec": 6.264
    },
    {
      "index": 20,
      "text": "Если ум блуждает, милостиво обратите на это внимание и вернитесь к этому дыханию.",
      "file": "c020.ogg",
      "durationSec": 10.224
    },
    {
      "index": 21,
      "text": "Представьте, что вы просыпаетесь рядом с широким тихим озером.",
      "file": "c021.ogg",
      "durationSec": 8.088
    },
    {
      "index": 22,
      "text": "Утренний свет мягко ложится на воду.",
      "file": "c022.ogg",
      "durationSec": 5.472
    },
    {
      "index": 23,
      "text": "Прохладный воздух касается щек чистой свежестью.",
      "file": "c023.ogg",
      "durationSec": 7.008
    },
    {
      "index": 24,
      "text": "Первое солнце согревает ступни.",
      "file": "c024.ogg",
      "durationSec": 5.208
    },
    {
      "index": 25,
      "text": "Вы начинаете медленную прогулку вдоль берега.",
      "file": "c025.ogg",
      "durationSec": 6.504
    },
    {
      "index": 26,
      "text": "Песок и мелкие гладкие камни мягко перекатываются под ногами.",
      "file": "c026.ogg",
      "durationSec": 8.088
    },
    {
      "index": 27,
      "text": "Каждый шаг – это тихий разговор с землей.",
      "file": "c027.ogg",
      "durationSec": 6.12
    },
    {
      "index": 28,
      "text": "От воды дует ветерок — свежий, слегка прохладный.",
      "file": "c028.ogg",
      "durationSec": 7.512
    },
    {
      "index": 29,
      "text": "Он приподнимает волосы на висках.",
      "file": "c029.ogg",
      "durationSec": 5.352
    },
    {
      "index": 30,
      "text": "Запах кедра, мокрых камней и открытого утра.",
      "file": "c030.ogg",
      "durationSec": 6.768
    },
    {
      "index": 31,
      "text": "Посмотрите, как цапля стоит на мелководье совершенно неподвижно.",
      "file": "c031.ogg",
      "durationSec": 60.513
    },
    {
      "index": 32,
      "text": "Вы поддерживаете эту тишину на несколько вдохов.",
      "file": "c032.ogg",
      "durationSec": 45.707
    },
    {
      "index": 33,
      "text": "С восходом солнца тепло окутывает ваши плечи.",
      "file": "c033.ogg",
      "durationSec": 42.266
    },
    {
      "index": 34,
      "text": "Найдите освещенный солнцем валун и сядьте.",
      "file": "c034.ogg",
      "durationSec": 6.504
    },
    {
      "index": 35,
      "text": "Почувствуйте, как тепло, накопленное в камне, поднимается в ваше тело.",
      "file": "c035.ogg",
      "durationSec": 9.408
    },
    {
      "index": 36,
      "text": "Почувствуйте, как свежий воздух проходит через ваши губы с каждым вдохом.",
      "file": "c036.ogg",
      "durationSec": 8.928
    },
    {
      "index": 37,
      "text": "Поверхность озера морщится, а затем снова становится стеклянной.",
      "file": "c037.ogg",
      "durationSec": 8.688
    },
    {
      "index": 38,
      "text": "Свет дрожит там тихой радостью.",
      "file": "c038.ogg",
      "durationSec": 5.736
    },
    {
      "index": 39,
      "text": "Продолжайте движение по изгибу берега в небольшую бухту.",
      "file": "c039.ogg",
      "durationSec": 7.32
    },
    {
      "index": 40,
      "text": "Ридс шепчет. Вода мягко тикает по дереву.",
      "file": "c040.ogg",
      "durationSec": 8.712
    },
    {
      "index": 41,
      "text": "Тянется старый причал. Ты идешь до конца.",
      "file": "c041.ogg",
      "durationSec": 8.136
    },
    {
      "index": 42,
      "text": "Сядьте, свесив ноги над прохладной водой.",
      "file": "c042.ogg",
      "durationSec": 6.408
    },
    {
      "index": 43,
      "text": "Солнце на твоей спине. Ветерок на твоих голенях.",
      "file": "c043.ogg",
      "durationSec": 9.048
    },
    {
      "index": 44,
      "text": "Опустите палец ноги. Нежный холодок. Улыбка, которую не нужно показывать.",
      "file": "c044.ogg",
      "durationSec": 13.872
    },
    {
      "index": 45,
      "text": "Откиньтесь на теплые доски.",
      "file": "c045.ogg",
      "durationSec": 4.848
    },
    {
      "index": 46,
      "text": "Услышьте воду под собой. Небо над тобой.",
      "file": "c046.ogg",
      "durationSec": 8.28
    },
    {
      "index": 47,
      "text": "Ваше дыхание становится таким же широким, как озеро.",
      "file": "c047.ogg",
      "durationSec": 7.368
    },
    {
      "index": 48,
      "text": "Вдохните свежесть. Выдохните в бесконечную синеву.",
      "file": "c048.ogg",
      "durationSec": 9.48
    },
    {
      "index": 49,
      "text": "Нечего решать. Только это тепло, этот воздух, этот покой.",
      "file": "c049.ogg",
      "durationSec": 10.512
    },
    {
      "index": 50,
      "text": "Почувствуйте тепло причала вдоль позвоночника.",
      "file": "c050.ogg",
      "durationSec": 6.456
    },
    {
      "index": 51,
      "text": "Почувствуйте прохладную ленту воздуха всякий раз, когда дует ветер.",
      "file": "c051.ogg",
      "durationSec": 8.328
    },
    {
      "index": 52,
      "text": "Стрекоза прошила воздух и исчезла.",
      "file": "c052.ogg",
      "durationSec": 6.0
    },
    {
      "index": 53,
      "text": "Оставайтесь до тех пор, пока чувство не проникнет в мышцы и кости.",
      "file": "c053.ogg",
      "durationSec": 8.616
    },
    {
      "index": 54,
      "text": "Если разум перечисляет задачи, поставьте их пока на дальний берег.",
      "file": "c054.ogg",
      "durationSec": 8.664
    },
    {
      "index": 55,
      "text": "Они могут подождать. Озеро ничего не ждет.",
      "file": "c055.ogg",
      "durationSec": 8.328
    },
    {
      "index": 56,
      "text": "Одна рука на животе. Рост. Падать.",
      "file": "c056.ogg",
      "durationSec": 9.672
    },
    {
      "index": 57,
      "text": "Тепло под ладонью другой руки по дереву.",
      "file": "c057.ogg",
      "durationSec": 5.616
    },
    {
      "index": 58,
      "text": "Покойтесь в этой двойной удержке — теле и месте.",
      "file": "c058.ogg",
      "durationSec": 6.96
    },
    {
      "index": 59,
      "text": "Встаньте и пройдите в воображении немного дальше.",
      "file": "c059.ogg",
      "durationSec": 6.432
    },
    {
      "index": 60,
      "text": "Камешки тихо щелкают. Вода светлеет возле упавшей ветки.",
      "file": "c060.ogg",
      "durationSec": 10.32
    },
    {
      "index": 61,
      "text": "Солнце ласкает затылок приятным теплом.",
      "file": "c061.ogg",
      "durationSec": 6.072
    },
    {
      "index": 62,
      "text": "Тень от ивы охлаждает веки на несколько шагов.",
      "file": "c062.ogg",
      "durationSec": 6.48
    },
    {
      "index": 63,
      "text": "Чередование тепла и свежести становится ходячей молитвой.",
      "file": "c063.ogg",
      "durationSec": 7.536
    },
    {
      "index": 64,
      "text": "Никаких слов не требуется. Только ощущения и дыхание.",
      "file": "c064.ogg",
      "durationSec": 10.464
    },
    {
      "index": 65,
      "text": "Найдите участок теплого песка и сядьте лицом к открытой воде.",
      "file": "c065.ogg",
      "durationSec": 8.064
    },
    {
      "index": 66,
      "text": "Пусть глаза плавно скользнут по линии горизонта.",
      "file": "c066.ogg",
      "durationSec": 6.648
    },
    {
      "index": 67,
      "text": "Вдохните прохладный аромат озера.",
      "file": "c067.ogg",
      "durationSec": 6.048
    },
    {
      "index": 68,
      "text": "Выдохните в сторону далеких холмов.",
      "file": "c068.ogg",
      "durationSec": 5.688
    },
    {
      "index": 69,
      "text": "Все, что вы принесли сюда, может остаться на берегу рядом с вами.",
      "file": "c069.ogg",
      "durationSec": 8.256
    },
    {
      "index": 70,
      "text": "Его не нужно носить с собой в воде.",
      "file": "c070.ogg",
      "durationSec": 5.256
    },
    {
      "index": 71,
      "text": "Оставайтесь до тех пор, пока следующие три вдоха не почувствуют себя завершенными.",
      "file": "c071.ogg",
      "durationSec": 9.912
    },
    {
      "index": 72,
      "text": "Теперь оставьте историю в покое и оставайтесь сенсацией.",
      "file": "c072.ogg",
      "durationSec": 7.8
    },
    {
      "index": 73,
      "text": "Вдохните свежесть этого места.",
      "file": "c073.ogg",
      "durationSec": 5.448
    },
    {
      "index": 74,
      "text": "Вдохните его тепло и тишину.",
      "file": "c074.ogg",
      "durationSec": 5.232
    },
    {
      "index": 75,
      "text": "Вдохните.",
      "file": "c075.ogg",
      "durationSec": 3.36
    },
    {
      "index": 76,
      "text": "Выдохните.",
      "file": "c076.ogg",
      "durationSec": 3.336
    },
    {
      "index": 77,
      "text": "Снова. Мягкий вдох.",
      "file": "c077.ogg",
      "durationSec": 6.264
    },
    {
      "index": 78,
      "text": "Более длинный выдох.",
      "file": "c078.ogg",
      "durationSec": 4.248
    },
    {
      "index": 79,
      "text": "Почувствуйте тело, удерживаемое землей этого воображаемого мира.",
      "file": "c079.ogg",
      "durationSec": 8.688
    },
    {
      "index": 80,
      "text": "Вдохните.",
      "file": "c080.ogg",
      "durationSec": 3.36
    },
    {
      "index": 81,
      "text": "Выдохните.",
      "file": "c081.ogg",
      "durationSec": 3.336
    },
    {
      "index": 82,
      "text": "Если мысли блуждают, вернитесь к теплу на коже.",
      "file": "c082.ogg",
      "durationSec": 6.696
    },
    {
      "index": 83,
      "text": "Или охладить воздух у носа.",
      "file": "c083.ogg",
      "durationSec": 5.016
    },
    {
      "index": 84,
      "text": "Вдохните.",
      "file": "c084.ogg",
      "durationSec": 3.36
    },
    {
      "index": 85,
      "text": "Выдохните.",
      "file": "c085.ogg",
      "durationSec": 3.336
    },
    {
      "index": 86,
      "text": "Вдохните.",
      "file": "c086.ogg",
      "durationSec": 3.36
    },
    {
      "index": 87,
      "text": "Выдохните.",
      "file": "c087.ogg",
      "durationSec": 3.336
    },
    {
      "index": 88,
      "text": "Оставаться. Смягчить. Продолжать.",
      "file": "c088.ogg",
      "durationSec": 9.648
    },
    {
      "index": 89,
      "text": "Вдохните.",
      "file": "c089.ogg",
      "durationSec": 3.36
    },
    {
      "index": 90,
      "text": "Выдохните.",
      "file": "c090.ogg",
      "durationSec": 3.336
    },
    {
      "index": 91,
      "text": "Еще один легкий цикл.",
      "file": "c091.ogg",
      "durationSec": 5.016
    },
    {
      "index": 92,
      "text": "Вдохните.",
      "file": "c092.ogg",
      "durationSec": 3.36
    },
    {
      "index": 93,
      "text": "Выдохните.",
      "file": "c093.ogg",
      "durationSec": 3.336
    },
    {
      "index": 94,
      "text": "Задержитесь в этом чувстве еще на несколько вдохов.",
      "file": "c094.ogg",
      "durationSec": 6.792
    },
    {
      "index": 95,
      "text": "Тепло. Мягкость. Достаточно.",
      "file": "c095.ogg",
      "durationSec": 9.36
    },
    {
      "index": 96,
      "text": "Вы можете вернуться в это место, когда вам это понадобится.",
      "file": "c096.ogg",
      "durationSec": 7.32
    },
    {
      "index": 97,
      "text": "Оно живет в вашем внимании, а не только в воображении.",
      "file": "c097.ogg",
      "durationSec": 7.608
    },
    {
      "index": 98,
      "text": "Начните углублять дыхание.",
      "file": "c098.ogg",
      "durationSec": 5.424
    },
    {
      "index": 99,
      "text": "Снова почувствуйте комнату вокруг себя.",
      "file": "c099.ogg",
      "durationSec": 5.88
    },
    {
      "index": 100,
      "text": "Пошевелите пальцами. Смягчите пальцы ног.",
      "file": "c100.ogg",
      "durationSec": 8.592
    },
    {
      "index": 101,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c101.ogg",
      "durationSec": 5.76
    },
    {
      "index": 102,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c102.ogg",
      "durationSec": 5.328
    },
    {
      "index": 103,
      "text": "Несите это спокойствие во все, что произойдет дальше.",
      "file": "c103.ogg",
      "durationSec": 7.464
    }
  ]
}

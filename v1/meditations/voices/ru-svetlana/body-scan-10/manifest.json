{
  "id": "body-scan-10",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 255,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Найдите время, чтобы приехать.",
      "file": "c001.ogg",
      "durationSec": 5.616
    },
    {
      "index": 2,
      "text": "Сядьте или лягте с поддержкой.",
      "file": "c002.ogg",
      "durationSec": 5.472
    },
    {
      "index": 3,
      "text": "Закройте глаза, если это безопасно.",
      "file": "c003.ogg",
      "durationSec": 5.832
    },
    {
      "index": 4,
      "text": "Почувствуйте контакт с землей.",
      "file": "c004.ogg",
      "durationSec": 5.4
    },
    {
      "index": 5,
      "text": "Медленный вдох.",
      "file": "c005.ogg",
      "durationSec": 3.744
    },
    {
      "index": 6,
      "text": "Более длинный выдох.",
      "file": "c006.ogg",
      "durationSec": 4.248
    },
    {
      "index": 7,
      "text": "[пауза:21]",
      "file": "c007.ogg",
      "durationSec": 4.392
    },
    {
      "index": 8,
      "text": "Снова.",
      "file": "c008.ogg",
      "durationSec": 3.0
    },
    {
      "index": 9,
      "text": "[пауза:21]",
      "file": "c009.ogg",
      "durationSec": 4.392
    },
    {
      "index": 10,
      "text": "Позвольте плечам опуститься.",
      "file": "c010.ogg",
      "durationSec": 5.04
    },
    {
      "index": 11,
      "text": "Пусть живот смягчится.",
      "file": "c011.ogg",
      "durationSec": 4.728
    },
    {
      "index": 12,
      "text": "[пауза:27]",
      "file": "c012.ogg",
      "durationSec": 4.272
    },
    {
      "index": 13,
      "text": "Начните с макушки головы.",
      "file": "c013.ogg",
      "durationSec": 4.944
    },
    {
      "index": 14,
      "text": "Обратите внимание на ощущение или его отсутствие.",
      "file": "c014.ogg",
      "durationSec": 7.296
    },
    {
      "index": 15,
      "text": "[пауза:27]",
      "file": "c015.ogg",
      "durationSec": 4.272
    },
    {
      "index": 16,
      "text": "Лоб. Глаза. Щеки. Челюсть.",
      "file": "c016.ogg",
      "durationSec": 11.304
    },
    {
      "index": 17,
      "text": "Дайте лицу немного растаять.",
      "file": "c017.ogg",
      "durationSec": 4.824
    },
    {
      "index": 18,
      "text": "[пауза:27]",
      "file": "c018.ogg",
      "durationSec": 4.272
    },
    {
      "index": 19,
      "text": "Горло. Шея. Плечи.",
      "file": "c019.ogg",
      "durationSec": 8.832
    },
    {
      "index": 20,
      "text": "Предложите плечам опуститься.",
      "file": "c020.ogg",
      "durationSec": 5.256
    },
    {
      "index": 21,
      "text": "[пауза:32]",
      "file": "c021.ogg",
      "durationSec": 4.08
    },
    {
      "index": 22,
      "text": "Оружие. Локти. Запястья. Руки. Пальцы.",
      "file": "c022.ogg",
      "durationSec": 15.216
    },
    {
      "index": 23,
      "text": "[пауза:32]",
      "file": "c023.ogg",
      "durationSec": 4.08
    },
    {
      "index": 24,
      "text": "Грудная клетка поднимается и опускается.",
      "file": "c024.ogg",
      "durationSec": 6.672
    },
    {
      "index": 25,
      "text": "Сердце пространство мягкое.",
      "file": "c025.ogg",
      "durationSec": 5.184
    },
    {
      "index": 26,
      "text": "[пауза:27]",
      "file": "c026.ogg",
      "durationSec": 4.272
    },
    {
      "index": 27,
      "text": "Живот. Низкая спинка. Бедра.",
      "file": "c027.ogg",
      "durationSec": 9.576
    },
    {
      "index": 28,
      "text": "[пауза:32]",
      "file": "c028.ogg",
      "durationSec": 4.08
    },
    {
      "index": 29,
      "text": "Бедра. Колени. Телята. Лодыжки. Ноги. Пальцы ног.",
      "file": "c029.ogg",
      "durationSec": 17.496
    },
    {
      "index": 30,
      "text": "[пауза:38]",
      "file": "c030.ogg",
      "durationSec": 4.584
    },
    {
      "index": 31,
      "text": "Ощутите все тело как одно поле.",
      "file": "c031.ogg",
      "durationSec": 5.544
    },
    {
      "index": 32,
      "text": "Дыхание проходит через него.",
      "file": "c032.ogg",
      "durationSec": 4.824
    },
    {
      "index": 33,
      "text": "[пауза:54]",
      "file": "c033.ogg",
      "durationSec": 5.04
    },
    {
      "index": 34,
      "text": "Если напряжённое место остаётся, направьте туда выдох.",
      "file": "c034.ogg",
      "durationSec": 7.656
    },
    {
      "index": 35,
      "text": "[пауза:43]",
      "file": "c035.ogg",
      "durationSec": 4.128
    },
    {
      "index": 36,
      "text": "Отдыхайте в осознании всего тела.",
      "file": "c036.ogg",
      "durationSec": 5.424
    },
    {
      "index": 37,
      "text": "[пауза:81]",
      "file": "c037.ogg",
      "durationSec": 4.656
    },
    {
      "index": 38,
      "text": "[пауза:32]",
      "file": "c038.ogg",
      "durationSec": 4.08
    },
    {
      "index": 39,
      "text": "Начните углублять дыхание.",
      "file": "c039.ogg",
      "durationSec": 5.424
    },
    {
      "index": 40,
      "text": "Почувствуйте комнату снова.",
      "file": "c040.ogg",
      "durationSec": 4.752
    },
    {
      "index": 41,
      "text": "Шевелите пальцами рук и ног.",
      "file": "c041.ogg",
      "durationSec": 4.824
    },
    {
      "index": 42,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c042.ogg",
      "durationSec": 5.76
    },
    {
      "index": 43,
      "text": "Медленно двигайтесь к тому, что будет дальше.",
      "file": "c043.ogg",
      "durationSec": 6.528
    }
  ]
}

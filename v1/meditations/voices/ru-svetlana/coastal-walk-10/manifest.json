{
  "id": "coastal-walk-10",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 678,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Найдите позу, которая ничего от вас не требует.",
      "file": "c001.ogg",
      "durationSec": 6.792
    },
    {
      "index": 2,
      "text": "Сядьте или лягте с любой поддержкой, которая вам нужна.",
      "file": "c002.ogg",
      "durationSec": 7.632
    },
    {
      "index": 3,
      "text": "Пусть ваши руки будут открытыми или мягкими.",
      "file": "c003.ogg",
      "durationSec": 6.528
    },
    {
      "index": 4,
      "text": "Позвольте глазам закрыться или сохраняйте мягкий взгляд.",
      "file": "c004.ogg",
      "durationSec": 7.368
    },
    {
      "index": 5,
      "text": "Почувствуйте места, где ваше тело встречается с землей.",
      "file": "c005.ogg",
      "durationSec": 7.344
    },
    {
      "index": 6,
      "text": "Пятки, седалищные кости, затылок или длина позвоночника.",
      "file": "c006.ogg",
      "durationSec": 8.496
    },
    {
      "index": 7,
      "text": "Нечего сейчас задерживать.",
      "file": "c007.ogg",
      "durationSec": 5.04
    },
    {
      "index": 8,
      "text": "Сделайте медленный вдох через нос.",
      "file": "c008.ogg",
      "durationSec": 5.4
    },
    {
      "index": 9,
      "text": "Почувствуйте прохладу приходящего воздуха.",
      "file": "c009.ogg",
      "durationSec": 6.024
    },
    {
      "index": 10,
      "text": "И выдохните еще немного.",
      "file": "c010.ogg",
      "durationSec": 4.656
    },
    {
      "index": 11,
      "text": "Почувствуйте, как уходит тепло выдоха.",
      "file": "c011.ogg",
      "durationSec": 5.928
    },
    {
      "index": 12,
      "text": "Снова. Мягкий вдох.",
      "file": "c012.ogg",
      "durationSec": 6.264
    },
    {
      "index": 13,
      "text": "Неторопливый выдох.",
      "file": "c013.ogg",
      "durationSec": 3.912
    },
    {
      "index": 14,
      "text": "Позвольте плечам немного опуститься.",
      "file": "c014.ogg",
      "durationSec": 5.784
    },
    {
      "index": 15,
      "text": "Позвольте челюсти разжаться.",
      "file": "c015.ogg",
      "durationSec": 4.944
    },
    {
      "index": 16,
      "text": "Пусть живот будет мягким.",
      "file": "c016.ogg",
      "durationSec": 4.728
    },
    {
      "index": 17,
      "text": "Оставайтесь с тремя спокойными вдохами, как есть.",
      "file": "c017.ogg",
      "durationSec": 7.032
    },
    {
      "index": 18,
      "text": "Вдохните. Приезжать.",
      "file": "c018.ogg",
      "durationSec": 6.552
    },
    {
      "index": 19,
      "text": "Выдохните. Решить.",
      "file": "c019.ogg",
      "durationSec": 6.264
    },
    {
      "index": 20,
      "text": "Если ум блуждает, милостиво обратите на это внимание и вернитесь к этому дыханию.",
      "file": "c020.ogg",
      "durationSec": 10.224
    },
    {
      "index": 21,
      "text": "Посмотрите прибрежную тропу вдоль невысоких скал.",
      "file": "c021.ogg",
      "durationSec": 6.864
    },
    {
      "index": 22,
      "text": "Океан внизу дышит длинными, равномерными волнами.",
      "file": "c022.ogg",
      "durationSec": 7.296
    },
    {
      "index": 23,
      "text": "Солнечный свет согревает макушку головы и переносицу.",
      "file": "c023.ogg",
      "durationSec": 7.704
    },
    {
      "index": 24,
      "text": "Соленый ветерок охлаждает веки яркой свежестью.",
      "file": "c024.ogg",
      "durationSec": 7.224
    },
    {
      "index": 25,
      "text": "Запах моря — минеральный, чистый, бодрящий.",
      "file": "c025.ogg",
      "durationSec": 8.04
    },
    {
      "index": 26,
      "text": "Вы идете медленно. Травы наклоняются вглубь суши на ветру.",
      "file": "c026.ogg",
      "durationSec": 9.768
    },
    {
      "index": 27,
      "text": "Почувствуйте солнце на одной щеке и прохладный воздух на другой.",
      "file": "c027.ogg",
      "durationSec": 7.776
    },
    {
      "index": 28,
      "text": "Этот контраст сам по себе является своего рода спокойствием.",
      "file": "c028.ogg",
      "durationSec": 7.92
    },
    {
      "index": 29,
      "text": "Деревянная лестница ведет вниз к скрытому пляжу.",
      "file": "c029.ogg",
      "durationSec": 6.744
    },
    {
      "index": 30,
      "text": "Каждый шаг уверен. Ваша рука лежит на обветренном рельсе.",
      "file": "c030.ogg",
      "durationSec": 9.672
    },
    {
      "index": 31,
      "text": "Теплая древесина под ладонью.",
      "file": "c031.ogg",
      "durationSec": 4.944
    },
    {
      "index": 32,
      "text": "Внизу песок принимает ваши ноги, как мягкое «да».",
      "file": "c032.ogg",
      "durationSec": 8.592
    },
    {
      "index": 33,
      "text": "Идите туда, где волны пишут и стирают белые линии.",
      "file": "c033.ogg",
      "durationSec": 7.344
    },
    {
      "index": 34,
      "text": "Прохладная вода окутывает ваши лодыжки.",
      "file": "c034.ogg",
      "durationSec": 6.216
    },
    {
      "index": 35,
      "text": "Теплый песок выше на берегу ждет, когда вы отступите.",
      "file": "c035.ogg",
      "durationSec": 7.488
    },
    {
      "index": 36,
      "text": "Сидеть. Закопайте руки в нагретые солнцем зерна.",
      "file": "c036.ogg",
      "durationSec": 9.072
    },
    {
      "index": 37,
      "text": "Почувствуйте это сухое тепло на фоне прохладного влажного песка.",
      "file": "c037.ogg",
      "durationSec": 7.704
    },
    {
      "index": 38,
      "text": "Наблюдайте, как свет разбивается в открытой воде.",
      "file": "c038.ogg",
      "durationSec": 6.84
    },
    {
      "index": 39,
      "text": "Вдохните свежесть ветерка.",
      "file": "c039.ogg",
      "durationSec": 5.064
    },
    {
      "index": 40,
      "text": "Выдохните все напряжение, которое все еще сохраняется в ребрах.",
      "file": "c040.ogg",
      "durationSec": 8.592
    },
    {
      "index": 41,
      "text": "Чайка кричит один раз и становится частью тишины.",
      "file": "c041.ogg",
      "durationSec": 7.128
    },
    {
      "index": 42,
      "text": "Ложись обратно. Закройте глаза.",
      "file": "c042.ogg",
      "durationSec": 7.512
    },
    {
      "index": 43,
      "text": "Тепло спереди. Прохладная земная тень по бокам.",
      "file": "c043.ogg",
      "durationSec": 8.76
    },
    {
      "index": 44,
      "text": "Ритм прилива успокаивает ваше сердце.",
      "file": "c044.ogg",
      "durationSec": 6.144
    },
    {
      "index": 45,
      "text": "Вы в лучшем смысле маленькие — вас держит что-то огромное и доброе.",
      "file": "c045.ogg",
      "durationSec": 9.072
    },
    {
      "index": 46,
      "text": "Оставайтесь с солнечным теплом в закрытых глазах.",
      "file": "c046.ogg",
      "durationSec": 6.72
    },
    {
      "index": 47,
      "text": "Оставайтесь с прохладным поцелуем брызг на вашей коже, когда ветер поворачивает.",
      "file": "c047.ogg",
      "durationSec": 9.744
    },
    {
      "index": 48,
      "text": "Мир не где-то еще. Это этот берег, это дыхание, это тело.",
      "file": "c048.ogg",
      "durationSec": 10.344
    },
    {
      "index": 49,
      "text": "Погрузитесь пятками поглубже в теплый песок.",
      "file": "c049.ogg",
      "durationSec": 6.36
    },
    {
      "index": 50,
      "text": "Почувствуйте, как земля отвечает устойчивой поддержкой.",
      "file": "c050.ogg",
      "durationSec": 7.464
    },
    {
      "index": 51,
      "text": "Вдохните солёную свежесть до дна лёгких.",
      "file": "c051.ogg",
      "durationSec": 6.336
    },
    {
      "index": 52,
      "text": "Выдохните все, что готовилось к удару.",
      "file": "c052.ogg",
      "durationSec": 6.264
    },
    {
      "index": 53,
      "text": "Никакого воздействия здесь нет. Только приход за приходом волн.",
      "file": "c053.ogg",
      "durationSec": 9.96
    },
    {
      "index": 54,
      "text": "Пусть пять вдохов будут следовать одному и тому же терпеливому ритму.",
      "file": "c054.ogg",
      "durationSec": 8.496
    },
    {
      "index": 55,
      "text": "Затем отдохните в лучах солнца на коже.",
      "file": "c055.ogg",
      "durationSec": 6.024
    },
    {
      "index": 56,
      "text": "Поднимитесь и пройдите немного по ватерлинии.",
      "file": "c056.ogg",
      "durationSec": 6.144
    },
    {
      "index": 57,
      "text": "Левая нога прохладная и влажная. Правая нога теплая и сухая. Затем переключитесь.",
      "file": "c057.ogg",
      "durationSec": 15.792
    },
    {
      "index": 58,
      "text": "Тело воспринимает контраст как комфорт, а не как конфликт.",
      "file": "c058.ogg",
      "durationSec": 8.232
    },
    {
      "index": 59,
      "text": "Возьмите гладкий камень, нагретый светом.",
      "file": "c059.ogg",
      "durationSec": 6.528
    },
    {
      "index": 60,
      "text": "Почувствуйте его тепло в ладони. Его плотность. Здесь тихо.",
      "file": "c060.ogg",
      "durationSec": 12.144
    },
    {
      "index": 61,
      "text": "Положите его с благодарностью — хранить его не нужно.",
      "file": "c061.ogg",
      "durationSec": 6.888
    },
    {
      "index": 62,
      "text": "Хранение внутреннее.",
      "file": "c062.ogg",
      "durationSec": 4.68
    },
    {
      "index": 63,
      "text": "Посмотрите за буруны на более спокойный цвет.",
      "file": "c063.ogg",
      "durationSec": 6.216
    },
    {
      "index": 64,
      "text": "Дышите так, как будто вы чувствуете вкус синего.",
      "file": "c064.ogg",
      "durationSec": 7.104
    },
    {
      "index": 65,
      "text": "Свежий ветерок. Теплая щека. Мягкий живот.",
      "file": "c065.ogg",
      "durationSec": 11.112
    },
    {
      "index": 66,
      "text": "Пусть следующий вдох будет самым глубоким в практике.",
      "file": "c066.ogg",
      "durationSec": 7.32
    },
    {
      "index": 67,
      "text": "Пусть выдох будет пустым, без силы.",
      "file": "c067.ogg",
      "durationSec": 5.952
    },
    {
      "index": 68,
      "text": "Бухта, скала, дорога домой — все ждет без напряжения.",
      "file": "c068.ogg",
      "durationSec": 8.232
    },
    {
      "index": 69,
      "text": "Теперь оставьте историю в покое и оставайтесь сенсацией.",
      "file": "c069.ogg",
      "durationSec": 7.8
    },
    {
      "index": 70,
      "text": "Вдохните свежесть этого места.",
      "file": "c070.ogg",
      "durationSec": 5.448
    },
    {
      "index": 71,
      "text": "Вдохните его тепло и тишину.",
      "file": "c071.ogg",
      "durationSec": 5.232
    },
    {
      "index": 72,
      "text": "Вдохните.",
      "file": "c072.ogg",
      "durationSec": 3.36
    },
    {
      "index": 73,
      "text": "Выдохните.",
      "file": "c073.ogg",
      "durationSec": 3.336
    },
    {
      "index": 74,
      "text": "Снова. Мягкий вдох.",
      "file": "c074.ogg",
      "durationSec": 6.264
    },
    {
      "index": 75,
      "text": "Более длинный выдох.",
      "file": "c075.ogg",
      "durationSec": 4.248
    },
    {
      "index": 76,
      "text": "Почувствуйте тело, удерживаемое землей этого воображаемого мира.",
      "file": "c076.ogg",
      "durationSec": 8.688
    },
    {
      "index": 77,
      "text": "Вдохните.",
      "file": "c077.ogg",
      "durationSec": 3.36
    },
    {
      "index": 78,
      "text": "Выдохните.",
      "file": "c078.ogg",
      "durationSec": 3.336
    },
    {
      "index": 79,
      "text": "Если мысли блуждают, вернитесь к теплу на коже.",
      "file": "c079.ogg",
      "durationSec": 6.696
    },
    {
      "index": 80,
      "text": "Или охладить воздух у носа.",
      "file": "c080.ogg",
      "durationSec": 5.016
    },
    {
      "index": 81,
      "text": "Вдохните.",
      "file": "c081.ogg",
      "durationSec": 3.36
    },
    {
      "index": 82,
      "text": "Выдохните.",
      "file": "c082.ogg",
      "durationSec": 3.336
    },
    {
      "index": 83,
      "text": "Вдохните.",
      "file": "c083.ogg",
      "durationSec": 3.36
    },
    {
      "index": 84,
      "text": "Выдохните.",
      "file": "c084.ogg",
      "durationSec": 3.336
    },
    {
      "index": 85,
      "text": "Оставаться. Смягчить. Продолжать.",
      "file": "c085.ogg",
      "durationSec": 9.648
    },
    {
      "index": 86,
      "text": "Вдохните.",
      "file": "c086.ogg",
      "durationSec": 3.36
    },
    {
      "index": 87,
      "text": "Выдохните.",
      "file": "c087.ogg",
      "durationSec": 3.336
    },
    {
      "index": 88,
      "text": "Еще один легкий цикл.",
      "file": "c088.ogg",
      "durationSec": 5.016
    },
    {
      "index": 89,
      "text": "Вдохните.",
      "file": "c089.ogg",
      "durationSec": 3.36
    },
    {
      "index": 90,
      "text": "Выдохните.",
      "file": "c090.ogg",
      "durationSec": 3.336
    },
    {
      "index": 91,
      "text": "Задержитесь в этом чувстве еще на несколько вдохов.",
      "file": "c091.ogg",
      "durationSec": 6.792
    },
    {
      "index": 92,
      "text": "Тепло. Мягкость. Достаточно.",
      "file": "c092.ogg",
      "durationSec": 9.36
    },
    {
      "index": 93,
      "text": "Вы можете вернуться в это место, когда вам это понадобится.",
      "file": "c093.ogg",
      "durationSec": 7.32
    },
    {
      "index": 94,
      "text": "Оно живет в вашем внимании, а не только в воображении.",
      "file": "c094.ogg",
      "durationSec": 7.608
    },
    {
      "index": 95,
      "text": "Начните углублять дыхание.",
      "file": "c095.ogg",
      "durationSec": 5.424
    },
    {
      "index": 96,
      "text": "Снова почувствуйте комнату вокруг себя.",
      "file": "c096.ogg",
      "durationSec": 5.88
    },
    {
      "index": 97,
      "text": "Пошевелите пальцами. Смягчите пальцы ног.",
      "file": "c097.ogg",
      "durationSec": 8.592
    },
    {
      "index": 98,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c098.ogg",
      "durationSec": 5.76
    },
    {
      "index": 99,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c099.ogg",
      "durationSec": 5.328
    },
    {
      "index": 100,
      "text": "Несите это спокойствие во все, что произойдет дальше.",
      "file": "c100.ogg",
      "durationSec": 7.464
    }
  ]
}

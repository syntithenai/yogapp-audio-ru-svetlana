{
  "id": "progressive-release-10",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 374,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "В этой практике используется мягкое напряжение и расслабление.",
      "file": "c001.ogg",
      "durationSec": 7.8
    },
    {
      "index": 2,
      "text": "Если можете, лягте или сядьте с поддержкой.",
      "file": "c002.ogg",
      "durationSec": 6.888
    },
    {
      "index": 3,
      "text": "Закройте глаза, если это безопасно.",
      "file": "c003.ogg",
      "durationSec": 5.832
    },
    {
      "index": 4,
      "text": "Нечего заставлять. Оставайтесь в комфортном диапазоне.",
      "file": "c004.ogg",
      "durationSec": 9.432
    },
    {
      "index": 5,
      "text": "Сделайте медленный вдох.",
      "file": "c005.ogg",
      "durationSec": 4.584
    },
    {
      "index": 6,
      "text": "И более длинный выдох.",
      "file": "c006.ogg",
      "durationSec": 4.32
    },
    {
      "index": 7,
      "text": "[пауза: 19]",
      "file": "c007.ogg",
      "durationSec": 4.368
    },
    {
      "index": 8,
      "text": "Направьте внимание на обе ноги.",
      "file": "c008.ogg",
      "durationSec": 5.208
    },
    {
      "index": 9,
      "text": "Согните пальцы ног и напрягите ступни.",
      "file": "c009.ogg",
      "durationSec": 6.24
    },
    {
      "index": 10,
      "text": "Держать.",
      "file": "c010.ogg",
      "durationSec": 3.096
    },
    {
      "index": 11,
      "text": "[пауза: 19]",
      "file": "c011.ogg",
      "durationSec": 4.368
    },
    {
      "index": 12,
      "text": "Выпускать.",
      "file": "c012.ogg",
      "durationSec": 3.288
    },
    {
      "index": 13,
      "text": "Почувствуйте разницу.",
      "file": "c013.ogg",
      "durationSec": 4.296
    },
    {
      "index": 14,
      "text": "[пауза:21]",
      "file": "c014.ogg",
      "durationSec": 4.392
    },
    {
      "index": 15,
      "text": "Напрягите икры.",
      "file": "c015.ogg",
      "durationSec": 3.984
    },
    {
      "index": 16,
      "text": "Держать.",
      "file": "c016.ogg",
      "durationSec": 3.096
    },
    {
      "index": 17,
      "text": "[пауза: 19]",
      "file": "c017.ogg",
      "durationSec": 4.368
    },
    {
      "index": 18,
      "text": "Выпускать.",
      "file": "c018.ogg",
      "durationSec": 3.288
    },
    {
      "index": 19,
      "text": "Пусть голени отяжелеют.",
      "file": "c019.ogg",
      "durationSec": 4.824
    },
    {
      "index": 20,
      "text": "[пауза:21]",
      "file": "c020.ogg",
      "durationSec": 4.392
    },
    {
      "index": 21,
      "text": "Напрягите бедра.",
      "file": "c021.ogg",
      "durationSec": 3.888
    },
    {
      "index": 22,
      "text": "Держать.",
      "file": "c022.ogg",
      "durationSec": 3.096
    },
    {
      "index": 23,
      "text": "[пауза: 19]",
      "file": "c023.ogg",
      "durationSec": 4.368
    },
    {
      "index": 24,
      "text": "Выпускать.",
      "file": "c024.ogg",
      "durationSec": 3.288
    },
    {
      "index": 25,
      "text": "Мягкие ножки. Мягкие бедра.",
      "file": "c025.ogg",
      "durationSec": 7.536
    },
    {
      "index": 26,
      "text": "[пауза:21]",
      "file": "c026.ogg",
      "durationSec": 4.392
    },
    {
      "index": 27,
      "text": "Аккуратно втяните живот.",
      "file": "c027.ogg",
      "durationSec": 4.8
    },
    {
      "index": 28,
      "text": "Держитесь без напряжения.",
      "file": "c028.ogg",
      "durationSec": 5.088
    },
    {
      "index": 29,
      "text": "[пауза: 19]",
      "file": "c029.ogg",
      "durationSec": 4.368
    },
    {
      "index": 30,
      "text": "Выпускать.",
      "file": "c030.ogg",
      "durationSec": 3.288
    },
    {
      "index": 31,
      "text": "Позвольте животу свободно двигаться при дыхании.",
      "file": "c031.ogg",
      "durationSec": 6.384
    },
    {
      "index": 32,
      "text": "[пауза:21]",
      "file": "c032.ogg",
      "durationSec": 4.392
    },
    {
      "index": 33,
      "text": "Сожмите кулаки. Напрягите руки и предплечья.",
      "file": "c033.ogg",
      "durationSec": 9.384
    },
    {
      "index": 34,
      "text": "Держать.",
      "file": "c034.ogg",
      "durationSec": 3.096
    },
    {
      "index": 35,
      "text": "[пауза: 19]",
      "file": "c035.ogg",
      "durationSec": 4.368
    },
    {
      "index": 36,
      "text": "Выпускать.",
      "file": "c036.ogg",
      "durationSec": 3.288
    },
    {
      "index": 37,
      "text": "Пальцы открыты. Руки тяжелые.",
      "file": "c037.ogg",
      "durationSec": 7.512
    },
    {
      "index": 38,
      "text": "[пауза:21]",
      "file": "c038.ogg",
      "durationSec": 4.392
    },
    {
      "index": 39,
      "text": "Поднимите плечи вверх к ушам.",
      "file": "c039.ogg",
      "durationSec": 5.088
    },
    {
      "index": 40,
      "text": "Держать.",
      "file": "c040.ogg",
      "durationSec": 3.096
    },
    {
      "index": 41,
      "text": "[пауза: 19]",
      "file": "c041.ogg",
      "durationSec": 4.368
    },
    {
      "index": 42,
      "text": "Отбросьте их.",
      "file": "c042.ogg",
      "durationSec": 3.792
    },
    {
      "index": 43,
      "text": "Почувствуйте пространство в верхней части спины.",
      "file": "c043.ogg",
      "durationSec": 6.432
    },
    {
      "index": 44,
      "text": "[пауза:21]",
      "file": "c044.ogg",
      "durationSec": 4.392
    },
    {
      "index": 45,
      "text": "Аккуратно поморгайте лицо. Глаза, брови, челюсть.",
      "file": "c045.ogg",
      "durationSec": 10.536
    },
    {
      "index": 46,
      "text": "Держать.",
      "file": "c046.ogg",
      "durationSec": 3.096
    },
    {
      "index": 47,
      "text": "[пауза: 19]",
      "file": "c047.ogg",
      "durationSec": 4.368
    },
    {
      "index": 48,
      "text": "Выпускать.",
      "file": "c048.ogg",
      "durationSec": 3.288
    },
    {
      "index": 49,
      "text": "Лоб гладкий. Челюсть мягкая. Язык отдыхает.",
      "file": "c049.ogg",
      "durationSec": 12.144
    },
    {
      "index": 50,
      "text": "[пауза:23]",
      "file": "c050.ogg",
      "durationSec": 4.2
    },
    {
      "index": 51,
      "text": "Теперь слегка напрягите все тело, как одно целое.",
      "file": "c051.ogg",
      "durationSec": 7.464
    },
    {
      "index": 52,
      "text": "Задержите дыхание.",
      "file": "c052.ogg",
      "durationSec": 4.608
    },
    {
      "index": 53,
      "text": "[пауза:35]",
      "file": "c053.ogg",
      "durationSec": 4.512
    },
    {
      "index": 54,
      "text": "Пусть все пройдет.",
      "file": "c054.ogg",
      "durationSec": 4.176
    },
    {
      "index": 55,
      "text": "[пауза:8]",
      "file": "c055.ogg",
      "durationSec": 3.792
    },
    {
      "index": 56,
      "text": "Еще раз более легкое сжатие всего тела.",
      "file": "c056.ogg",
      "durationSec": 6.24
    },
    {
      "index": 57,
      "text": "Подержите ненадолго.",
      "file": "c057.ogg",
      "durationSec": 4.296
    },
    {
      "index": 58,
      "text": "[пауза:5]",
      "file": "c058.ogg",
      "durationSec": 4.104
    },
    {
      "index": 59,
      "text": "И отпустить полностью.",
      "file": "c059.ogg",
      "durationSec": 4.584
    },
    {
      "index": 60,
      "text": "Теперь тяжелее. Теперь мягче.",
      "file": "c060.ogg",
      "durationSec": 7.584
    },
    {
      "index": 61,
      "text": "Почувствуйте, как тело оседает на поверхности под вами.",
      "file": "c061.ogg",
      "durationSec": 7.632
    },
    {
      "index": 62,
      "text": "[пауза:39]",
      "file": "c062.ogg",
      "durationSec": 4.56
    },
    {
      "index": 63,
      "text": "Отдых здесь.",
      "file": "c063.ogg",
      "durationSec": 3.504
    },
    {
      "index": 64,
      "text": "Дышите спокойно. Тело мягкое.",
      "file": "c064.ogg",
      "durationSec": 7.8
    },
    {
      "index": 65,
      "text": "Если мысли вернутся, это нормально.",
      "file": "c065.ogg",
      "durationSec": 5.784
    },
    {
      "index": 66,
      "text": "Вернитесь к ощущению освобождения.",
      "file": "c066.ogg",
      "durationSec": 6.336
    },
    {
      "index": 67,
      "text": "[пауза: 50]",
      "file": "c067.ogg",
      "durationSec": 4.512
    },
    {
      "index": 68,
      "text": "Оставайся мягким.",
      "file": "c068.ogg",
      "durationSec": 4.08
    },
    {
      "index": 69,
      "text": "[пауза: 40]",
      "file": "c069.ogg",
      "durationSec": 4.008
    },
    {
      "index": 70,
      "text": "Шевелите пальцами рук и ног.",
      "file": "c070.ogg",
      "durationSec": 4.824
    },
    {
      "index": 71,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c071.ogg",
      "durationSec": 5.328
    },
    {
      "index": 72,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c072.ogg",
      "durationSec": 5.76
    },
    {
      "index": 73,
      "text": "Носите эту нежность с собой.",
      "file": "c073.ogg",
      "durationSec": 5.112
    }
  ]
}

{
  "id": "lakeside-dawn-5",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 397,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Сядьте поудобнее или лягте, если так удобнее.",
      "file": "c001.ogg",
      "durationSec": 7.488
    },
    {
      "index": 2,
      "text": "Дайте рукам отдохнуть.",
      "file": "c002.ogg",
      "durationSec": 4.464
    },
    {
      "index": 3,
      "text": "Позвольте глазам закрыться или смягчите взгляд.",
      "file": "c003.ogg",
      "durationSec": 6.6
    },
    {
      "index": 4,
      "text": "Обратите внимание на вес вашего тела.",
      "file": "c004.ogg",
      "durationSec": 5.976
    },
    {
      "index": 5,
      "text": "Сделайте медленный вдох через нос.",
      "file": "c005.ogg",
      "durationSec": 5.4
    },
    {
      "index": 6,
      "text": "И более длинный и легкий выдох.",
      "file": "c006.ogg",
      "durationSec": 5.064
    },
    {
      "index": 7,
      "text": "Снова. Мягкий вдох.",
      "file": "c007.ogg",
      "durationSec": 6.264
    },
    {
      "index": 8,
      "text": "Мягкий выдох.",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
      "text": "Если мысли блуждают, это нормально. Вернитесь к дыханию.",
      "file": "c009.ogg",
      "durationSec": 10.032
    },
    {
      "index": 10,
      "text": "Представьте себя на берегу тихого озера на рассвете.",
      "file": "c010.ogg",
      "durationSec": 6.864
    },
    {
      "index": 11,
      "text": "Вода держит бледно-серебряное небо.",
      "file": "c011.ogg",
      "durationSec": 5.736
    },
    {
      "index": 12,
      "text": "Прохладный воздух окутывает ваши щеки чистой свежестью.",
      "file": "c012.ogg",
      "durationSec": 7.608
    },
    {
      "index": 13,
      "text": "Мягкая лента солнца начинает согревать ваши плечи.",
      "file": "c013.ogg",
      "durationSec": 7.056
    },
    {
      "index": 14,
      "text": "Почувствуйте, как тепло медленно распространяется по вашей спине.",
      "file": "c014.ogg",
      "durationSec": 8.352
    },
    {
      "index": 15,
      "text": "Ты подходишь ближе. Мягкий песок подступает под ноги.",
      "file": "c015.ogg",
      "durationSec": 9.432
    },
    {
      "index": 16,
      "text": "Опустите кончики пальцев в воду. Прохладный. Прозрачный.",
      "file": "c016.ogg",
      "durationSec": 11.976
    },
    {
      "index": 17,
      "text": "Рябь распространяется наружу и исчезает.",
      "file": "c017.ogg",
      "durationSec": 6.432
    },
    {
      "index": 18,
      "text": "Ветерок слабо пахнет водными растениями и утром.",
      "file": "c018.ogg",
      "durationSec": 7.08
    },
    {
      "index": 19,
      "text": "Слушать. Почти ничего. Далекая птица. Ваше собственное дыхание.",
      "file": "c019.ogg",
      "durationSec": 15.744
    },
    {
      "index": 20,
      "text": "Сядьте на гладкий камень, достаточно нагретый восходящим светом.",
      "file": "c020.ogg",
      "durationSec": 8.472
    },
    {
      "index": 21,
      "text": "Почувствуйте тихое тепло камня под собой.",
      "file": "c021.ogg",
      "durationSec": 6.0
    },
    {
      "index": 22,
      "text": "Почувствуйте свежесть воздуха, проникающего в ваши легкие.",
      "file": "c022.ogg",
      "durationSec": 8.232
    },
    {
      "index": 23,
      "text": "Озеро отражает нежно-розовый и золотой цвета.",
      "file": "c023.ogg",
      "durationSec": 6.864
    },
    {
      "index": 24,
      "text": "Вы наблюдаете, как свет движется по поверхности, как медленное дыхание.",
      "file": "c024.ogg",
      "durationSec": 9.624
    },
    {
      "index": 25,
      "text": "Рыба поднимается, кольца расширяются, затем возвращается зеркало.",
      "file": "c025.ogg",
      "durationSec": 9.0
    },
    {
      "index": 26,
      "text": "Тепло на твоих закрытых веках.",
      "file": "c026.ogg",
      "durationSec": 5.304
    },
    {
      "index": 27,
      "text": "Прохлада на тыльной стороне рук.",
      "file": "c027.ogg",
      "durationSec": 4.944
    },
    {
      "index": 28,
      "text": "Где-то вдалеке веревка лодки щелкает по дереву.",
      "file": "c028.ogg",
      "durationSec": 6.6
    },
    {
      "index": 29,
      "text": "Потом снова тишина, широкая и добрая.",
      "file": "c029.ogg",
      "durationSec": 6.792
    },
    {
      "index": 30,
      "text": "Вдохните прохладное утро. Выдохните в открытую воду.",
      "file": "c030.ogg",
      "durationSec": 9.696
    },
    {
      "index": 31,
      "text": "Покой успокаивает то, как туман поднимается над водой — мягко и полностью.",
      "file": "c031.ogg",
      "durationSec": 10.32
    },
    {
      "index": 32,
      "text": "Вам разрешено занять место в этой тишине.",
      "file": "c032.ogg",
      "durationSec": 6.096
    },
    {
      "index": 33,
      "text": "Еще один вкус рассвета.",
      "file": "c033.ogg",
      "durationSec": 4.992
    },
    {
      "index": 34,
      "text": "Посмотрите еще раз на серебряную дорожку света на воде.",
      "file": "c034.ogg",
      "durationSec": 6.96
    },
    {
      "index": 35,
      "text": "Следуйте за ним мягкими глазами в сторону дальнего берега.",
      "file": "c035.ogg",
      "durationSec": 7.296
    },
    {
      "index": 36,
      "text": "Деревья там синие от дали и утреннего тумана.",
      "file": "c036.ogg",
      "durationSec": 7.008
    },
    {
      "index": 37,
      "text": "По мере того, как поднимается солнце, на ваших плечах становится немного тепло.",
      "file": "c037.ogg",
      "durationSec": 9.504
    },
    {
      "index": 38,
      "text": "Ветер остается свежим — рожденным в озере и чистым.",
      "file": "c038.ogg",
      "durationSec": 7.776
    },
    {
      "index": 39,
      "text": "Пусть эта свежесть омоет разум, как свет ополаскивает поверхность.",
      "file": "c039.ogg",
      "durationSec": 8.64
    },
    {
      "index": 40,
      "text": "Посидите и сделайте еще три вдоха одновременно теплого и прохладного воздуха.",
      "file": "c040.ogg",
      "durationSec": 9.216
    },
    {
      "index": 41,
      "text": "Теперь отдохните некоторое время в одиночестве.",
      "file": "c041.ogg",
      "durationSec": 6.12
    },
    {
      "index": 42,
      "text": "Медленно вдохните.",
      "file": "c042.ogg",
      "durationSec": 4.2
    },
    {
      "index": 43,
      "text": "Медленно выдохните.",
      "file": "c043.ogg",
      "durationSec": 4.248
    },
    {
      "index": 44,
      "text": "Вдохните.",
      "file": "c044.ogg",
      "durationSec": 3.36
    },
    {
      "index": 45,
      "text": "Выдохните.",
      "file": "c045.ogg",
      "durationSec": 3.336
    },
    {
      "index": 46,
      "text": "Почувствуйте тепло везде, где тепло телу.",
      "file": "c046.ogg",
      "durationSec": 6.36
    },
    {
      "index": 47,
      "text": "Почувствуйте прохладу там, где воздух прохладный.",
      "file": "c047.ogg",
      "durationSec": 6.912
    },
    {
      "index": 48,
      "text": "Вдохните.",
      "file": "c048.ogg",
      "durationSec": 3.36
    },
    {
      "index": 49,
      "text": "Выдохните.",
      "file": "c049.ogg",
      "durationSec": 3.336
    },
    {
      "index": 50,
      "text": "Некуда идти. Нечего исправлять.",
      "file": "c050.ogg",
      "durationSec": 7.992
    },
    {
      "index": 51,
      "text": "Вдохните.",
      "file": "c051.ogg",
      "durationSec": 3.36
    },
    {
      "index": 52,
      "text": "Выдохните.",
      "file": "c052.ogg",
      "durationSec": 3.336
    },
    {
      "index": 53,
      "text": "Отдохните здесь и сделайте несколько спокойных вдохов.",
      "file": "c053.ogg",
      "durationSec": 7.272
    },
    {
      "index": 54,
      "text": "Знайте, что вы можете вернуться в это место в любое время.",
      "file": "c054.ogg",
      "durationSec": 7.68
    },
    {
      "index": 55,
      "text": "Когда будете готовы, сделайте глубокий вдох.",
      "file": "c055.ogg",
      "durationSec": 6.432
    },
    {
      "index": 56,
      "text": "Шевелите пальцами рук и ног.",
      "file": "c056.ogg",
      "durationSec": 4.824
    },
    {
      "index": 57,
      "text": "Тихо откройте глаза.",
      "file": "c057.ogg",
      "durationSec": 4.152
    },
    {
      "index": 58,
      "text": "Носите с собой частичку этого мира.",
      "file": "c058.ogg",
      "durationSec": 6.024
    }
  ]
}

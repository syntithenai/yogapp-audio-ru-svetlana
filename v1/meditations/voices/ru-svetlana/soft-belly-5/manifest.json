{
  "id": "soft-belly-5",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 167,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Найдите удобное сиденье или лягте, если вам так удобнее.",
      "file": "c001.ogg",
      "durationSec": 8.256
    },
    {
      "index": 2,
      "text": "Дайте рукам отдохнуть.",
      "file": "c002.ogg",
      "durationSec": 4.464
    },
    {
      "index": 3,
      "text": "Смягчите глаза или закройте их.",
      "file": "c003.ogg",
      "durationSec": 5.664
    },
    {
      "index": 4,
      "text": "Сделайте медленный вдох.",
      "file": "c004.ogg",
      "durationSec": 4.584
    },
    {
      "index": 5,
      "text": "И более длинный выдох.",
      "file": "c005.ogg",
      "durationSec": 4.32
    },
    {
      "index": 6,
      "text": "Если хотите, положите руку на нижнюю часть живота.",
      "file": "c006.ogg",
      "durationSec": 7.392
    },
    {
      "index": 7,
      "text": "Обратите внимание, держится ли живот.",
      "file": "c007.ogg",
      "durationSec": 5.784
    },
    {
      "index": 8,
      "text": "[пауза: 20]",
      "file": "c008.ogg",
      "durationSec": 4.008
    },
    {
      "index": 9,
      "text": "На следующем вдохе позвольте животу расшириться.",
      "file": "c009.ogg",
      "durationSec": 6.72
    },
    {
      "index": 10,
      "text": "На выдохе позвольте ему упасть, не сжимая.",
      "file": "c010.ogg",
      "durationSec": 6.912
    },
    {
      "index": 11,
      "text": "[пауза: 20]",
      "file": "c011.ogg",
      "durationSec": 4.008
    },
    {
      "index": 12,
      "text": "Снова. Мягкий живот внутри.",
      "file": "c012.ogg",
      "durationSec": 7.176
    },
    {
      "index": 13,
      "text": "Мягкий живот наружу.",
      "file": "c013.ogg",
      "durationSec": 4.344
    },
    {
      "index": 14,
      "text": "[пауза: 25]",
      "file": "c014.ogg",
      "durationSec": 4.416
    },
    {
      "index": 15,
      "text": "Если разум спорит, позвольте телу вести.",
      "file": "c015.ogg",
      "durationSec": 6.456
    },
    {
      "index": 16,
      "text": "Расширение. Выпускать.",
      "file": "c016.ogg",
      "durationSec": 6.936
    },
    {
      "index": 17,
      "text": "[пауза:29]",
      "file": "c017.ogg",
      "durationSec": 4.44
    },
    {
      "index": 18,
      "text": "Плечи опускаются.",
      "file": "c018.ogg",
      "durationSec": 4.416
    },
    {
      "index": 19,
      "text": "Челюсть мягкая.",
      "file": "c019.ogg",
      "durationSec": 4.32
    },
    {
      "index": 20,
      "text": "Живот свободный.",
      "file": "c020.ogg",
      "durationSec": 4.104
    },
    {
      "index": 21,
      "text": "[пауза: 25]",
      "file": "c021.ogg",
      "durationSec": 4.416
    },
    {
      "index": 22,
      "text": "Оставайтесь на десяти тихих вдохах мягким животом.",
      "file": "c022.ogg",
      "durationSec": 7.296
    },
    {
      "index": 23,
      "text": "[пауза: 45]",
      "file": "c023.ogg",
      "durationSec": 4.296
    },
    {
      "index": 24,
      "text": "Обратите внимание на появившуюся легкость.",
      "file": "c024.ogg",
      "durationSec": 6.192
    },
    {
      "index": 25,
      "text": "[пауза: 20]",
      "file": "c025.ogg",
      "durationSec": 4.008
    },
    {
      "index": 26,
      "text": "Отдых здесь.",
      "file": "c026.ogg",
      "durationSec": 3.504
    },
    {
      "index": 27,
      "text": "[пауза:27]",
      "file": "c027.ogg",
      "durationSec": 4.272
    },
    {
      "index": 28,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c028.ogg",
      "durationSec": 5.328
    },
    {
      "index": 29,
      "text": "Пошевелите пальцами.",
      "file": "c029.ogg",
      "durationSec": 4.344
    },
    {
      "index": 30,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c030.ogg",
      "durationSec": 5.76
    },
    {
      "index": 31,
      "text": "Носите немного этого с собой.",
      "file": "c031.ogg",
      "durationSec": 5.16
    }
  ]
}

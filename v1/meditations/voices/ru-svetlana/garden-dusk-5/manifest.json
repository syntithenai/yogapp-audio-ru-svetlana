{
  "id": "garden-dusk-5",
  "voiceId": "ru-svetlana",
  "edgeVoice": "ru-RU-SvetlanaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 361,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Сядьте поудобнее или лягте, если так удобнее.",
      "file": "c001.ogg",
      "durationSec": 7.488
    },
    {
      "index": 2,
      "text": "Дайте рукам отдохнуть.",
      "file": "c002.ogg",
      "durationSec": 4.464
    },
    {
      "index": 3,
      "text": "Позвольте глазам закрыться или смягчите взгляд.",
      "file": "c003.ogg",
      "durationSec": 6.6
    },
    {
      "index": 4,
      "text": "Обратите внимание на вес вашего тела.",
      "file": "c004.ogg",
      "durationSec": 5.976
    },
    {
      "index": 5,
      "text": "Сделайте медленный вдох через нос.",
      "file": "c005.ogg",
      "durationSec": 5.4
    },
    {
      "index": 6,
      "text": "И более длинный и легкий выдох.",
      "file": "c006.ogg",
      "durationSec": 5.064
    },
    {
      "index": 7,
      "text": "Снова. Мягкий вдох.",
      "file": "c007.ogg",
      "durationSec": 6.264
    },
    {
      "index": 8,
      "text": "Мягкий выдох.",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
      "text": "Если мысли блуждают, это нормально. Вернитесь к дыханию.",
      "file": "c009.ogg",
      "durationSec": 10.032
    },
    {
      "index": 10,
      "text": "Представьте себе тихий огороженный сад в мягких сумерках.",
      "file": "c010.ogg",
      "durationSec": 7.776
    },
    {
      "index": 11,
      "text": "Каменные дорожки хранят последнее тепло дня.",
      "file": "c011.ogg",
      "durationSec": 6.24
    },
    {
      "index": 12,
      "text": "Почувствуйте это нежное тепло подошвами ног.",
      "file": "c012.ogg",
      "durationSec": 6.288
    },
    {
      "index": 13,
      "text": "Лаванда и вечерняя роза источают спокойный аромат.",
      "file": "c013.ogg",
      "durationSec": 7.512
    },
    {
      "index": 14,
      "text": "Прохладный ветерок скользит по стене и охлаждает шею.",
      "file": "c014.ogg",
      "durationSec": 7.44
    },
    {
      "index": 15,
      "text": "Воздух свеж после теплого дня.",
      "file": "c015.ogg",
      "durationSec": 5.208
    },
    {
      "index": 16,
      "text": "Вы медленно идете между живыми изгородями, подстриженными, мягкими, как дыхание.",
      "file": "c016.ogg",
      "durationSec": 10.992
    },
    {
      "index": 17,
      "text": "Ваши пальцы касаются листьев, все еще светящихся солнцем.",
      "file": "c017.ogg",
      "durationSec": 8.448
    },
    {
      "index": 18,
      "text": "Теплый. Гладкий. Живой.",
      "file": "c018.ogg",
      "durationSec": 8.88
    },
    {
      "index": 19,
      "text": "Деревянная скамейка ждет под тихим деревом.",
      "file": "c019.ogg",
      "durationSec": 6.288
    },
    {
      "index": 20,
      "text": "Вы сидите. Дерево приятно согревает спину.",
      "file": "c020.ogg",
      "durationSec": 8.616
    },
    {
      "index": 21,
      "text": "Небо над головой становится лавандовым и розовым.",
      "file": "c021.ogg",
      "durationSec": 6.744
    },
    {
      "index": 22,
      "text": "Птицы расселяются. В саду становится тише.",
      "file": "c022.ogg",
      "durationSec": 8.952
    },
    {
      "index": 23,
      "text": "Почувствуйте, как тепло мягко уходит от камня и дерева.",
      "file": "c023.ogg",
      "durationSec": 7.656
    },
    {
      "index": 24,
      "text": "Почувствуйте освежающую прохладу вечера на своем лице.",
      "file": "c024.ogg",
      "durationSec": 7.32
    },
    {
      "index": 25,
      "text": "Вдохните аромат и тишину.",
      "file": "c025.ogg",
      "durationSec": 5.376
    },
    {
      "index": 26,
      "text": "Выдохните день, который вы пронесли.",
      "file": "c026.ogg",
      "durationSec": 5.856
    },
    {
      "index": 27,
      "text": "Мотылек проходит сквозь последний золотой свет.",
      "file": "c027.ogg",
      "durationSec": 6.576
    },
    {
      "index": 28,
      "text": "Здесь нет ничего срочного. Всего достаточно.",
      "file": "c028.ogg",
      "durationSec": 9.072
    },
    {
      "index": 29,
      "text": "Покойтесь в этой достаточности.",
      "file": "c029.ogg",
      "durationSec": 5.16
    },
    {
      "index": 30,
      "text": "Пусть ваш живот смягчится в сумеречном воздухе.",
      "file": "c030.ogg",
      "durationSec": 6.576
    },
    {
      "index": 31,
      "text": "Пусть ваш следующий вздох будет самым тихим за день.",
      "file": "c031.ogg",
      "durationSec": 6.936
    },
    {
      "index": 32,
      "text": "Прежде чем закончить, пройдите один медленный круг тропы.",
      "file": "c032.ogg",
      "durationSec": 8.136
    },
    {
      "index": 33,
      "text": "Теплые камни остывают под ногами.",
      "file": "c033.ogg",
      "durationSec": 5.76
    },
    {
      "index": 34,
      "text": "Хеджес выпускает накопленные за день духи.",
      "file": "c034.ogg",
      "durationSec": 6.216
    },
    {
      "index": 35,
      "text": "Ветерок теперь приобрел вечерний оттенок — свежий, почти сладкий.",
      "file": "c035.ogg",
      "durationSec": 9.12
    },
    {
      "index": 36,
      "text": "Остановитесь у ворот, еще не открывая их.",
      "file": "c036.ogg",
      "durationSec": 6.432
    },
    {
      "index": 37,
      "text": "Почувствуйте, как спокойствие обосновалось в плечах.",
      "file": "c037.ogg",
      "durationSec": 7.488
    },
    {
      "index": 38,
      "text": "Несите тишину сада внутрь, как маленький фонарь.",
      "file": "c038.ogg",
      "durationSec": 7.08
    },
    {
      "index": 39,
      "text": "Теперь отдохните некоторое время в одиночестве.",
      "file": "c039.ogg",
      "durationSec": 6.12
    },
    {
      "index": 40,
      "text": "Медленно вдохните.",
      "file": "c040.ogg",
      "durationSec": 4.2
    },
    {
      "index": 41,
      "text": "Медленно выдохните.",
      "file": "c041.ogg",
      "durationSec": 4.248
    },
    {
      "index": 42,
      "text": "Вдохните.",
      "file": "c042.ogg",
      "durationSec": 3.36
    },
    {
      "index": 43,
      "text": "Выдохните.",
      "file": "c043.ogg",
      "durationSec": 3.336
    },
    {
      "index": 44,
      "text": "Почувствуйте тепло везде, где тепло телу.",
      "file": "c044.ogg",
      "durationSec": 6.36
    },
    {
      "index": 45,
      "text": "Почувствуйте прохладу там, где воздух прохладный.",
      "file": "c045.ogg",
      "durationSec": 6.912
    },
    {
      "index": 46,
      "text": "Вдохните.",
      "file": "c046.ogg",
      "durationSec": 3.36
    },
    {
      "index": 47,
      "text": "Выдохните.",
      "file": "c047.ogg",
      "durationSec": 3.336
    },
    {
      "index": 48,
      "text": "Некуда идти. Нечего исправлять.",
      "file": "c048.ogg",
      "durationSec": 7.992
    },
    {
      "index": 49,
      "text": "Вдохните.",
      "file": "c049.ogg",
      "durationSec": 3.36
    },
    {
      "index": 50,
      "text": "Выдохните.",
      "file": "c050.ogg",
      "durationSec": 3.336
    },
    {
      "index": 51,
      "text": "Отдохните здесь и сделайте несколько спокойных вдохов.",
      "file": "c051.ogg",
      "durationSec": 7.272
    },
    {
      "index": 52,
      "text": "Знайте, что вы можете вернуться в это место в любое время.",
      "file": "c052.ogg",
      "durationSec": 7.68
    },
    {
      "index": 53,
      "text": "Когда будете готовы, сделайте глубокий вдох.",
      "file": "c053.ogg",
      "durationSec": 6.432
    },
    {
      "index": 54,
      "text": "Шевелите пальцами рук и ног.",
      "file": "c054.ogg",
      "durationSec": 4.824
    },
    {
      "index": 55,
      "text": "Тихо откройте глаза.",
      "file": "c055.ogg",
      "durationSec": 4.152
    },
    {
      "index": 56,
      "text": "Носите с собой частичку этого мира.",
      "file": "c056.ogg",
      "durationSec": 6.024
    }
  ]
}

  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 210,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.96
    },
    {
      "index": 1,
      "text": "Найдите время, чтобы приехать.",
      "file": "c001.ogg",
      "durationSec": 5.616
    },
    {
      "index": 2,
      "text": "Сядьте или лягте с поддержкой.",
      "file": "c002.ogg",
      "durationSec": 5.472
    },
    {
      "index": 3,
      "text": "Закройте глаза, если это безопасно.",
      "file": "c003.ogg",
      "durationSec": 5.832
    },
    {
      "index": 4,
      "text": "Почувствуйте контакт с землей.",
      "file": "c004.ogg",
      "durationSec": 5.4
    },
    {
      "index": 5,
      "text": "Медленный вдох.",
      "file": "c005.ogg",
      "durationSec": 3.744
    },
    {
      "index": 6,
      "text": "Более длинный выдох.",
      "file": "c006.ogg",
      "durationSec": 4.248
    },
    {
      "index": 7,
      "text": "[пауза: 25]",
      "file": "c007.ogg",
      "durationSec": 4.416
    },
    {
      "index": 8,
      "text": "Снова.",
      "file": "c008.ogg",
      "durationSec": 3.0
    },
    {
      "index": 9,
      "text": "[пауза: 25]",
      "file": "c009.ogg",
      "durationSec": 4.416
    },
    {
      "index": 10,
      "text": "Позвольте плечам опуститься.",
      "file": "c010.ogg",
      "durationSec": 5.04
    },
    {
      "index": 11,
      "text": "Пусть живот смягчится.",
      "file": "c011.ogg",
      "durationSec": 4.728
    },
    {
      "index": 12,
      "text": "[пауза:31]",
      "file": "c012.ogg",
      "durationSec": 4.584
    },
    {
      "index": 13,
      "text": "Перенесите внимание на центр груди.",
      "file": "c013.ogg",
      "durationSec": 5.496
    },
    {
      "index": 14,
      "text": "Не насилуя чувства. Просто нахожу место.",
      "file": "c014.ogg",
      "durationSec": 8.064
    },
    {
      "index": 15,
      "text": "[пауза:31]",
      "file": "c015.ogg",
      "durationSec": 4.584
    },
    {
      "index": 16,
      "text": "Дышите так, как будто вдох входит через сердце.",
      "file": "c016.ogg",
      "durationSec": 7.392
    },
    {
      "index": 17,
      "text": "Словно выдох смягчает сердце изнутри.",
      "file": "c017.ogg",
      "durationSec": 6.168
    },
    {
      "index": 18,
      "text": "[пауза:37]",
      "file": "c018.ogg",
      "durationSec": 4.272
    },
    {
      "index": 19,
      "text": "Если возникает эмоция, позвольте ей двигаться, как погоде.",
      "file": "c019.ogg",
      "durationSec": 8.112
    },
    {
      "index": 20,
      "text": "[пауза:37]",
      "file": "c020.ogg",
      "durationSec": 4.272
    },
    {
      "index": 21,
      "text": "Молча: пусть мое сердце будет спокойно.",
      "file": "c021.ogg",
      "durationSec": 6.12
    },
    {
      "index": 22,
      "text": "[пауза:31]",
      "file": "c022.ogg",
      "durationSec": 4.584
    },
    {
      "index": 23,
      "text": "Могу ли я быть терпеливым в отношении своего времени.",
      "file": "c023.ogg",
      "durationSec": 6.864
    },
    {
      "index": 24,
      "text": "[пауза:31]",
      "file": "c024.ogg",
      "durationSec": 4.584
    },
    {
      "index": 25,
      "text": "Вспомните кого-то, о ком легко заботиться.",
      "file": "c025.ogg",
      "durationSec": 6.648
    },
    {
      "index": 26,
      "text": "Пожелайте им легкости.",
      "file": "c026.ogg",
      "durationSec": 4.632
    },
    {
      "index": 27,
      "text": "Пусть вам будет спокойно.",
      "file": "c027.ogg",
      "durationSec": 4.488
    },
    {
      "index": 28,
      "text": "[пауза:37]",
      "file": "c028.ogg",
      "durationSec": 4.272
    },
    {
      "index": 29,
      "text": "Вернитесь в пространство своего сердца.",
      "file": "c029.ogg",
      "durationSec": 5.88
    },
    {
      "index": 30,
      "text": "Теплый. Просторный. Человек.",
      "file": "c030.ogg",
      "durationSec": 9.168
    },
    {
      "index": 31,
      "text": "[пауза:75]",
      "file": "c031.ogg",
      "durationSec": 4.656
    },
    {
      "index": 32,
      "text": "Отдых здесь.",
      "file": "c032.ogg",
      "durationSec": 3.504
    },
    {
      "index": 33,
      "text": "[пауза: 90]",
      "file": "c033.ogg",
      "durationSec": 4.128
    },
    {
      "index": 34,
      "text": "[пауза:37]",
      "file": "c034.ogg",
      "durationSec": 4.272
    },
    {
      "index": 35,
      "text": "Начните углублять дыхание.",
      "file": "c035.ogg",
      "durationSec": 5.424
    },
    {
      "index": 36,
      "text": "Почувствуйте комнату снова.",
      "file": "c036.ogg",
      "durationSec": 4.752
    },
    {
      "index": 37,
      "text": "Шевелите пальцами рук и ног.",
      "file": "c037.ogg",
      "durationSec": 4.824
    },
    {
      "index": 38,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c038.ogg",
      "durationSec": 5.76
    },
    {
      "index": 39,
      "text": "Медленно двигайтесь к тому, что будет дальше.",
      "file": "c039.ogg",
      "durationSec": 6.528
    }
  ]
}
